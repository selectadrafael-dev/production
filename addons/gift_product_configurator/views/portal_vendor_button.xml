<odoo>

    <template id="portal_vendor_button" inherit_id="portal.portal_my_home">

        <xpath expr="//div[contains(@class, 'o_portal_docs')]" position="inside">

            <t t-if="request.env.user.partner_id.is_vendor_user or request.env.user.has_group('base.group_system')">
            <div class="vendor-tool-card">
                <a href="#"
                   class="o_portal_doc d-flex align-items-center justify-content-start"
                   data-bs-toggle="modal"
                   data-bs-target="#vendorDataModal">

                    <!-- ICON -->
                    <div class="o_portal_doc_icon me-3">
                        <i class="fa fa-upload"/>
                    </div>

                    <!-- TEXT -->
                    <div class="o_portal_doc_text">
                        <h5 class="mb-1">Vendor Data</h5>
                        <p class="mb-0 text-muted">
                            Upload product catalog or data
                        </p>
                    </div>

                </a>
            </div>
            </t>

        </xpath>

    </template>

</odoo>