<odoo>

    <template id="portal_vendor_button" inherit_id="portal.portal_my_home">

        <xpath expr="//div[contains(@class, 'o_portal_docs')]" position="inside">

            <t t-if="request.env.user.partner_id.is_vendor_user or request.env.user.has_group('base.group_system')">
            <div class="vendor-tool-card custom-portal-card">
                <a href="#"
                   class="o_portal_doc d-flex align-items-center justify-content-start vendor-data-modal-tab"
                   data-bs-toggle="modal"
                   data-bs-target="#vendorDataModal">

                    <!-- ICON -->
                    <div class="o_portal_doc_icon me-3">
                        <i class="fa fa-upload"/>
                    </div>

                    <!-- TEXT -->
                    <div class="o_portal_doc_text">
                        <h5 class="mb-1">
                            <t t-esc="_('Vendor Data')"/>
                        </h5>
                        <p class="mb-0 text-muted">
                            <t t-esc="_('Upload product catalog or data')"/>
                        </p>
                    </div>

                </a>

                 <!-- upload report -->
                 <a href="#"
                   class="o_portal_doc 
                   d-flex align-items-center 
                   justify-content-start 
                   vendor-data-status"
                   data-bs-toggle="modal"
                   data-bs-target="#vendorProductsModal"
                 >

                    <!-- ICON -->
                    <div class="o_portal_doc_icon me-3">
                        <i class="fa fa-upload"/>
                    </div>

                    <!-- TEXT -->
                    <div class="o_portal_doc_text">
                        <h5 class="mb-1">
                            <t t-esc="_('Upload Report')"/>
                        </h5>
                        <p class="mb-0 text-muted">
                            <t t-esc="_('Status')"/>
                        </p>
                    </div>

                </a>
            </div>
            </t>

        </xpath>

    </template>

</odoo>