<odoo>

  <template id="quote_drawer_global" inherit_id="website.layout">

    <xpath expr="//body" position="inside">

      <div id="quote_drawer" class="quote-drawer">

        <div class="drawer-header">
          <h3>Quote Now</h3>
          <button id="close_drawer">✕</button>
        </div>

        <!-- VISUAL TOGGLE -->

        <div class="visual-toggle">

          <label class="switch">
            <input type="checkbox" id="visual_toggle"/>
            <span class="slider"></span>
          </label>

          <span>Would you like a free visual?</span>

        </div>

        <!-- ARTWORK UPLOAD -->

        <form action="/quote/upload_artwork"
              method="post"
              enctype="multipart/form-data">

          <input type="file" name="artwork"/>

        </form>

        <!-- ITEMS -->

        <div id="quote_items" class="drawer-items"></div>

        <!-- ACTIONS -->

        <div class="drawer-footer">

          <button class="btn-primary">
            Place Your Quote Now
          </button>

          <button class="btn-secondary">
            Continue Shopping
          </button>

        </div>

      </div>

      <div id="drawer_overlay"></div>

    </xpath>

  </template>

</odoo>