<odoo>
  <data>

    <template id="shop_category_hero_perfect"
              inherit_id="website_sale.products"
              name="Category Hero Banner (Perfect Placement — Fully Safe)">

      <!-- INSERT HERO BEFORE PRODUCTS ROW -->
      <xpath expr="//div[contains(@class,'o_wsale_products_main_row')]"
             position="before">

        <!--GET CURRENT URL -->
        <t t-set="path" t-value="request.httprequest.path"/>

        <!--EXTRACT CATEGORY ID FROM /shop/category/...-ID -->
        <t t-set="cat_id"
           t-value="int(path.rsplit('-', 1)[-1])
                    if '/shop/category/' in path and '-' in path
                    else False"/>

        <!-- LOAD CATEGORY SAFELY -->
        <t t-set="cat"
           t-value="request.env['product.public.category'].sudo().browse(cat_id)
                    if cat_id else False"/>

        <!-- RENDER ONLY IF CATEGORY EXISTS -->
        <t t-if="cat and cat.exists()">

          <!-- 🛡️ SAFE FIELD ACCESS (NO getattr, NO CRASH) -->

          <t t-set="hero_title"
             t-value="cat.hero_title
                      if 'hero_title' in cat._fields and cat.hero_title
                      else cat.name"/>

          <t t-set="hero_subtitle"
             t-value="cat.hero_subtitle
                      if 'hero_subtitle' in cat._fields and cat.hero_subtitle
                      else ''"/>

          <t t-set="hero_description"
             t-value="cat.hero_description
                      if 'hero_description' in cat._fields and cat.hero_description
                      else ''"/>

          <t t-set="hero_color"
             t-value="cat.hero_bg_color
                      if 'hero_bg_color' in cat._fields and cat.hero_bg_color
                      else '#6E8FC6'"/>

          <!-- ⭐ HERO SECTION -->
          <!-- ========================= -->

          <!-- SAFE LAYOUT SWITCH -->
          <!-- ========================= -->

          <t t-set="layout"
            t-value="cat.hero_layout if 'hero_layout' in cat._fields else 'split'"/>

          <!-- CENTER LAYOUT -->
          <t t-if="layout == 'center'">

            <section class="category-hero layout-center"
                    t-att-style="'background:%s;' % hero_color">

              <div class="container">
                <div class="row py-5">

                  <div class="col-lg-6">
                    <nav class="mb-2 text-muted">
                      Home / <t t-esc="cat.name"/>
                    </nav>

                    <h1 class="fw-bold mb-3">
                      <t t-esc="hero_title"/>
                    </h1>

                    <h5>
                      <t t-esc="hero_subtitle"/>
                    </h5>
                  </div>

                  <div class="col-lg-6">
                    <p>
                      <t t-esc="hero_description"/>
                    </p>
                  </div>

                </div>
              </div>

            </section>

          </t>

          <!-- SPLIT LAYOUT -->
          <t t-elif="layout == 'split'">

            <!-- HERO (SHORT STRIP) -->
            <section class="category-hero layout-split"
                    t-att-style="'background:%s;' % hero_color">

              <div class="container-fluid">

                <div class="row">

                  <!-- EMPTY SPACE FOR SIDEBAR -->
                  <div class="col-lg-3"></div>

                  <!-- HERO TEXT -->
                  <div class="col-lg-7">

                    <div class="hero-content">

                      <nav class="mb-2 text-light">
                        Home / <t t-esc="cat.name"/>
                      </nav>

                      <h1 class="fw-bold mb-2 text-dark">
                        <t t-esc="hero_title"/>
                      </h1>

                      <p class="hero-description text-dark">
                        <t t-esc="hero_description"/>
                      </p>

                    </div>

                  </div>

                </div>

              </div>

            </section>


            <!-- FLOATING SIDEBAR (OUTSIDE HERO) -->
            <t t-set="children" t-value="cat.child_id"/>

            <t t-if="children">

              <div class="floating-sidebar">

                <div class="category-sidebar-box">

                  <h5 class="fw-bold mb-3">Shop by</h5>

                  <t t-foreach="children" t-as="child">

                    <div class="category-item">

                      <div class="category-name">
                        <t t-esc="child.name"/>
                      </div>

                      <a t-att-href="'/shop/category/%s' % child.id"
                        class="view-all">
                        View All
                      </a>

                    </div>

                  </t>

                </div>

              </div>

            </t>

          </t>

        </t>

      </xpath>

    </template>

  </data>
</odoo>