<odoo>
  <data>

    <template id="shop_category_hero_fullwidth"
              inherit_id="website_sale.products"
              name="Fullwidth Category Hero (Safe)">

      <!-- Wrap the main products row -->
      <xpath expr="//div[contains(@class,'o_wsale_products_main_row')]"
             position="attributes">

        <!-- Add hero class + background -->
        <attribute name="class"
                   add=" category-hero-full"/>

        <attribute name="t-att-style">
          "'background:%s;' % (category.hero_bg_color or '#6E8FC6')"
        </attribute>

      </xpath>

      <!-- Insert hero text at top of product column -->
      <xpath expr="//div[contains(@class,'o_wsale_products_main_col')]"
             position="inside">

        <t t-if="category">

          <div class="hero-text-block py-5">

            <nav class="mb-2 text-light">
              Home /
              <t t-esc="category.name"/>
            </nav>

            <h1 class="fw-bold">
              <t t-esc="category.hero_title or category.name"/>
            </h1>

            <h4 class="mb-3">
              <t t-esc="category.hero_subtitle"/>
            </h4>

            <p>
              <t t-esc="category.hero_description"/>
            </p>

            <div class="mt-4">

              <a href="/contactus"
                 class="btn btn-dark me-3">
                Get An Express Quote
              </a>

              <a href="/contactus"
                 class="btn btn-light">
                Contact Us
              </a>

            </div>

          </div>

        </t>

      </xpath>

    </template>

  </data>
</odoo>