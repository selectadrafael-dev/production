<odoo>
  <data>

    <template id="shop_category_hero_universal_safe"
              inherit_id="website_sale.products"
              name="Category Hero Banner (Universal Safe)">

      <!-- INSERT AT TOP OF PAGE -->
      <xpath expr="//div[@id='wrap']" position="inside">

        <!-- CATEGORY FROM URL -->
        <t t-set="path" t-value="request.httprequest.path"/>

        <t t-set="cat_id"
           t-value="int(path.rsplit('-', 1)[-1])
                    if '/shop/category/' in path and '-' in path
                    else False"/>

        <t t-set="cat"
           t-value="request.env['product.public.category'].sudo().browse(cat_id)
                    if cat_id else False"/>

        <t t-if="cat and cat.exists()">

          <!-- HERO -->
          <section class="category-hero-full"
                   t-att-style="'background:%s;' % (cat.hero_bg_color or '#6E8FC6')">

            <div class="container py-5">

              <div class="row">

                <!-- SPACE FOR FILTER SIDEBAR -->
                <div class="col-lg-3 d-none d-lg-block"></div>

                <!-- HERO CONTENT -->
                <div class="col-lg-9 text-dark">

                  <nav class="mb-2 text-light">
                    Home /
                    <t t-esc="cat.name"/>
                  </nav>

                  <h1 class="fw-bold">
                    <t t-esc="cat.hero_title or cat.name"/>
                  </h1>

                  <h4 class="mb-3">
                    <t t-esc="cat.hero_subtitle"/>
                  </h4>

                  <p>
                    <t t-esc="cat.hero_description"/>
                  </p>

                  <div class="mt-4">

                    <a href="/contactus"
                       class="btn btn-dark me-3">
                      Get An Express Quote
                    </a>

                    <a href="/contactus"
                       class="btn btn-light">
                      Contact Us
                    </a>

                  </div>

                </div>

              </div>

            </div>

          </section>

        </t>

      </xpath>

    </template>

  </data>
</odoo>