<odoo>
  <data>

    <template id="shop_category_hero_safe"
              inherit_id="website_sale.products"
              name="Category Hero Banner (Failsafe)">

      <!-- Insert BEFORE ANY content -->
      <xpath expr="." position="inside">

        <t t-if="category">

          <section class="category-hero-full"
                   t-att-style="'background:%s;' % (category.hero_bg_color or '#6E8FC6')">

            <div class="container py-5">

              <div class="row">

                <!-- LEFT SPACE for sidebar alignment -->
                <div class="col-lg-3 d-none d-lg-block"></div>

                <!-- RIGHT HERO CONTENT -->
                <div class="col-lg-9">

                  <nav class="mb-2 text-light">
                    Home /
                    <t t-esc="category.name"/>
                  </nav>

                  <h1 class="fw-bold">
                    <t t-esc="category.hero_title or category.name"/>
                  </h1>

                  <h4 class="mb-3">
                    <t t-esc="category.hero_subtitle"/>
                  </h4>

                  <p>
                    <t t-esc="category.hero_description"/>
                  </p>

                  <div class="mt-4">

                    <a href="/contactus"
                       class="btn btn-dark me-3">
                      Get An Express Quote
                    </a>

                    <a href="/contactus"
                       class="btn btn-light">
                      Contact Us
                    </a>

                  </div>

                </div>

              </div>

            </div>

          </section>

        </t>

      </xpath>

    </template>

  </data>
</odoo>