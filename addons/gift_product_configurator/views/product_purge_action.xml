<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record
        id="action_purge_imported_products"
        model="ir.actions.server"
    >

        <field name="name">
            Purge Imported Products
        </field>

        <field
            name="model_id"
            ref="product.model_product_template"
        />

        <field
            name="binding_model_id"
            ref="product.model_product_template"
        />

        <field name="binding_view_types">
            list
        </field>

        <field name="state">code</field>

        <field name="code">action = records.action_purge_imported_products()</field>

    </record>

</odoo>