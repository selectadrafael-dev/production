<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="bestsellers_page" name="Bestsellers Page">

<t t-call="website.layout">

<div id="wrap" class="oe_structure">

    <!-- HERO -->
    <section class="bs-hero">
        <div class="container">

            <div class="bs-hero-box">

                <div class="bs-breadcrumb">
                    Home / Bestsellers
                </div>

                <h1>Best-Selling Promotional Products</h1>

                <h3>Our Most Popular Branded Merchandise</h3>

                <p>
                    If you're looking for the best-selling promotional products,
                    look no further. We've got it all!
                </p>

                <div class="bs-actions">
                    <a href="#" class="btn-primary">Get An Express Quote</a>
                    <a href="/contactus" class="btn-secondary">Contact Us</a>
                </div>

            </div>

        </div>
    </section>


    <!-- MAIN LAYOUT -->
    <section class="bs-main">
        <div class="container">

            <div class="bs-layout">

                <!-- LEFT SIDEBAR -->
                <aside class="bs-sidebar">

                    <h4>Filter by</h4>

                    <div class="filter-group">
                        <h5>Colour</h5>

                        <label><input type="checkbox"/> Black</label>
                        <label><input type="checkbox"/> Blue</label>
                        <label><input type="checkbox"/> Brown</label>
                        <label><input type="checkbox"/> Burgundy</label>
                    </div>

                    <button class="clear-btn">
                        Clear filters
                    </button>

                </aside>


                <!-- RIGHT CONTENT -->
                <div class="bs-content">

                    <!-- TOOLBAR -->
                    <div class="bs-toolbar">

                        <div>Excludes VAT</div>

                        <div>
                            <t t-esc="len(products)"/> results
                        </div>

                        <div>Sort by</div>

                    </div>


                    <!-- PRODUCT GRID -->
                    <div class="bs-grid">

                        <t t-foreach="products" t-as="p">

                            <div class="product-card">

                                <a t-att-href="'/shop/product/%s' % p.id">

                                    <img t-att-src="'/web/image/product.template/%s/image_512' % p.id"/>

                                    <h6 t-esc="p.name"/>

                                    <div class="price">
                                        £<t t-esc="p.list_price"/>
                                    </div>

                                </a>

                            </div>

                        </t>

                    </div>

                </div>

            </div>

        </div>
    </section>

</div>

</t>
</template>

</odoo>