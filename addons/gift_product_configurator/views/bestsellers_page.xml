<odoo>

    <template id="bestsellers_page_template">

        <t t-call="website.layout">

            <!-- REQUIRED FOR WEBSITE EDITOR -->
            <div id="wrap" class="oe_structure">

                <section class="bestsellers-page">

                    <!-- HERO -->
                    <div class="bestsellers-hero">
                        <div class="container">

                            <div class="breadcrumbs">
                                Home / Bestsellers
                            </div>

                            <h1>Best-Selling Promotional Products</h1>
                            <h2>Our Most Popular Branded Merchandise</h2>

                            <p>
                                If you're looking for the best-selling promotional
                                products, look no further. We've got it all!
                            </p>

                            <div class="hero-actions">
                                <a href="#" class="btn-primary">
                                    Get An Express Quote
                                </a>
                                <a href="/contactus" class="btn-secondary">
                                    Contact Us
                                </a>
                            </div>

                        </div>
                    </div>

                    <!-- MAIN CONTENT -->
                    <div class="container bestsellers-layout">

                        <!-- LEFT FILTER SIDEBAR -->
                        <aside class="filters">
                            <h3>Filter by</h3>

                            <div class="filter-group">
                                <h4>Colour</h4>
                                <label><input type="checkbox"/> Black</label>
                                <label><input type="checkbox"/> Blue</label>
                                <label><input type="checkbox"/> Brown</label>
                                <label><input type="checkbox"/> Burgundy</label>
                            </div>

                            <button class="clear-btn">
                                Clear filters
                            </button>
                        </aside>

                        <!-- PRODUCTS GRID -->
                        <div class="products-area">

                            <div class="results-bar">
                                <span>Excludes VAT</span>
                                <span t-esc="len(products)"/> results
                                <span>Sort by</span>
                            </div>

                            <div class="products-grid">

                                <t t-foreach="products" t-as="product">

                                    <div class="product-card">

                                        <a t-att-href="'/shop/product/%s' % product.id">

                                            <img
                                                t-att-src="'/web/image/product.template/%s/image_512' % product.id"
                                                alt=""
                                            />

                                            <h4 t-esc="product.name"/>

                                            <p class="price">
                                                <span t-field="product.list_price"
                                                      t-options='{"widget": "monetary",
                                                      "display_currency": website.pricelist_id.currency_id}'/>
                                            </p>

                                        </a>

                                    </div>

                                </t>

                            </div>

                        </div>

                    </div>

                </section>

            </div>

        </t>

    </template>

</odoo>