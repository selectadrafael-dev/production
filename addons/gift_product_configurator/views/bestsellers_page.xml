<?xml version="1.0" encoding="utf-8"?>

<odoo>

  <record id="gift_bestsellers_page" model="website.page">
<field name="name">Bestsellers</field>
<field name="url">/bestsellers</field>
<field name="is_published" eval="True"/>
<field name="key">gift_product_configurator.bestsellers_page</field>
<field name="type">qweb</field>

<field name="arch" type="xml">

  <t t-name="gift_product_configurator.bestsellers_page">

    <t t-call="website.layout">

      <!-- REQUIRED WRAP -->
      <div id="wrap" class="oe_structure bestsellers-page">

        <!-- HERO -->
        <section class="bestseller-hero">

          <div class="container">

            <h1>Best-Selling Promotional Products</h1>

            <p>
              Our most popular branded merchandise trusted by customers.
            </p>

            <a href="/contactus" class="btn btn-primary">
              Get An Express Quote
            </a>

            <a href="/contactus" class="btn btn-secondary">
              Contact Us
            </a>

          </div>

        </section>


        <!-- PRODUCTS -->
        <section class="container bestseller-products">

          <!-- FIND CATEGORY -->
          <t t-set="category"
             t-value="request.env['product.public.category'].sudo().search([
               ('name', '=', 'Best Selling Promotional Products')
             ], limit=1)"/>

          <!-- FIND PUBLISHED PRODUCTS -->
          <t t-set="products"
             t-value="request.env['product.template'].sudo().search([
               ('public_categ_ids', 'in', category.ids),
               ('website_published', '=', True)
             ])"/>


          <div class="product-grid">

            <t t-foreach="products" t-as="product">

              <div class="product-card">

                <a t-att-href="'/shop/product/%s' % product.id">

                  <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"/>

                  <h5 t-esc="product.name"/>

                  <div class="price-note">
                    As low as (exc. VAT)
                  </div>

                  <strong>
                    <t t-esc="product.list_price"/>
                  </strong>

                </a>

              </div>

            </t>

          </div>

        </section>

        <!-- REQUIRED FOR BUILDER -->
        <div class="oe_structure"/>

      </div>

    </t>

  </t>

</field>

  </record>

</odoo>
