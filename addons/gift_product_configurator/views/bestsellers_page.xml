<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="bestsellers_page" name="Bestsellers Page">

        <t t-call="website.layout">

            <div id="wrap" class="oe_structure">

                <section class="container my-5">

                    <h1>Best-Selling Promotional Products</h1>

                    <p>Our most popular branded merchandise.</p>

                    <div class="row">

                        <t t-foreach="products" t-as="product">

                            <div class="col-lg-3 col-md-4 col-6 mb-4">

                                <a t-att-href="'/shop/product/%s' % product.id">

                                    <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"
                                         class="img-fluid rounded"/>

                                    <h6 class="mt-2">
                                        <t t-esc="product.name"/>
                                    </h6>

                                </a>

                            </div>

                        </t>

                    </div>

                </section>

            </div>

        </t>

    </template>

</odoo>