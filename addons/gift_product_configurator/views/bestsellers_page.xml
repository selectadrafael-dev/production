<odoo>

  <template id="bestsellers_template" name="Bestsellers Page">

    <t t-call="website.layout">

      <div class="container bestsellers-page">

        <!-- BREADCRUMB -->
        <div class="breadcrumb">
          <a href="/">Home</a> / Bestsellers
        </div>

        <!-- HERO -->
        <div class="bestseller-hero">

          <div class="hero-content">

            <h1>Best-Selling Promotional Products</h1>

            <p>
              Our most popular branded merchandise that customers love.
            </p>

            <div class="hero-buttons">
              <a href="/contactus" class="btn btn-primary">
                Get An Express Quote
              </a>

              <a href="/contactus" class="btn btn-outline">
                Contact Us
              </a>
            </div>

          </div>

        </div>


        <!-- MAIN LAYOUT -->
        <div class="bestseller-layout">

          <!-- FILTER SIDEBAR -->
          <aside class="filters" id="filtersPanel">

            <h4>Filter by</h4>

            <div class="filter-group">
              <strong>Price</strong>
              <input type="range"/>
            </div>

            <div class="filter-group">
              <strong>Colour</strong>
              <label><input type="checkbox"/> Black</label>
              <label><input type="checkbox"/> Blue</label>
              <label><input type="checkbox"/> Red</label>
            </div>

            <div class="filter-group">
              <strong>MOQ</strong>
              <label><input type="checkbox"/> 50</label>
              <label><input type="checkbox"/> 100</label>
              <label><input type="checkbox"/> 250</label>
              <label><input type="checkbox"/> 500</label>
            </div>

            <button class="clear-filters">
              Clear filters
            </button>

          </aside>


          <!-- RESULTS AREA -->
          <section class="product-results">

            <!-- MOBILE FILTER BUTTON -->
            <button class="mobile-filter-btn" id="openFilters">
              Filter
            </button>

            <!-- HEADER -->
            <div class="results-header">

              <div class="vat-toggle">
                Excludes VAT
                <input type="checkbox"/>
              </div>

              <div class="result-count">
                <t t-esc="len(products)"/> results
              </div>

              <div class="sort">
                <select>
                  <option>Sort by</option>
                  <option>Price Low → High</option>
                  <option>Price High → Low</option>
                </select>
              </div>

            </div>


            <!-- PRODUCT GRID -->
            <div class="product-grid">

              <t t-foreach="products" t-as="product">

                <div class="product-card">

                  <a t-att-href="'/shop/product/%s' % product.id">

                    <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"/>

                    <h5 t-esc="product.name"/>

                    <div class="price-note">
                      As low as (exc. VAT)
                    </div>

                    <strong>
                      <t t-esc="product.list_price"/>
                    </strong>

                  </a>

                </div>

              </t>

            </div>

          </section>

        </div>

      </div>

    </t>

  </template>

</odoo>