<odoo>

    <record
        id="product_template_vendor_currency_form"
        model="ir.ui.view">

        <field name="name">
            product.template.vendor.currency.form
        </field>

        <field name="model">
            product.template
        </field>

        <field name="inherit_id"
               ref="product.product_template_only_form_view"/>

        <field name="arch"
               type="xml">

            <xpath
                expr="//field[@name='list_price']"
                position="after">

                <field name="vendor_price"/>

                <field name="vendor_currency_id"/>

            </xpath>

        </field>

    </record>

</odoo>