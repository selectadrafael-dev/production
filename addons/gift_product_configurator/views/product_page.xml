<odoo>
    <template id="gift_custom_product_page" inherit_id="website_sale.product">
        <!-- REPLACE the entire product section to avoid ID conflicts -->
        <xpath expr="//section[@id='product_detail']" position="replace">
            <section id="product_detail" 
                     t-attf-class="oe_website_sale container my-3 my-lg-4 #{'js_sale' if combination_info else ''}" 
                     t-att-data-view-id="view_id">
                
                <!-- TOP PROMO BANNER -->
                <div class="gift-top-banner">
                    <a href="/bestsellers" class="banner-link">
                        ⭐ CLICK HERE FOR OUR MOST POPULAR PICKS ⭐
                        <span>Buy tried and tested items customers love</span>
                    </a>
                </div>

                <div class="gift-product-layout">
                    <!-- LEFT: GALLERY -->
                    <div class="gift-gallery">
                        <div class="product-image-wrapper">
                            <span class="flag-badge">🇬🇧</span>
                            <span class="offer-badge">SPECIAL OFFER</span>
                            
                            <!-- CRITICAL: Added 'oe_variant_img_main' for auto-swapping -->
                            <img t-att-src="image_data_uri(product.image_1024)" 
                                 class="main-product-image oe_variant_img_main"
                                 t-att-data-image-id="product.id"/>
                        </div>
                    </div>

                    <!-- CENTER: CONFIGURATOR -->
                    <div class="gift-configurator">
                        <h1 t-field="product.name"/>
                        <div class="product-code">
                            Product Code: <span class="js_product_default_code" t-esc="product.default_code"/>
                        </div>

                        <!-- CRITICAL: Form must have 'js_add_cart_variants' class -->
                        <form t-if="product.attribute_line_ids" class="js_add_cart_variants" method="POST">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            
                            <t t-foreach="product.attribute_line_ids" t-as="line">
                                <div class="config-block variant_attribute">
                                    <div class="config-header">
                                        <t t-esc="line.attribute_id.name"/>: 
                                        <span class="selected-value"><t t-esc="line.product_template_value_ids[0].name"/></span>
                                    </div>

                                    <div class="variant-options">
                                        <t t-foreach="line.product_template_value_ids" t-as="ptav">
                                            <label t-attf-class="variant-btn #{'active' if ptav == line.product_template_value_ids[0] else ''}">
                                                <!-- CRITICAL: Input must have 'js_variant_change' class -->
                                                <input type="radio"
                                                       class="js_variant_change"
                                                       t-att-name="'attr_%s' % line.attribute_id.id"
                                                       t-att-value="ptav.id"
                                                       t-att-data-value_id="ptav.id"
                                                       t-att-data-value_name="ptav.name"
                                                       t-att-checked="ptav == line.product_template_value_ids[0]"/>
                                                <span t-esc="ptav.name"/>
                                            </label>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </form>
                        
                        <!-- Rest of your UI (Print Method, etc.) -->
                    </div>

                    <!-- RIGHT: QUOTE PANEL -->
                    <div class="gift-quote-panel">
                        <div class="price-display">
                            <!-- CRITICAL: Use Odoo's price snippet for automatic variant price updates -->
                            <t t-call="website_sale.product_price"/>
                        </div>
                        <button class="js-add-quote btn-quote" t-att-data-product-id="product.product_variant_id.id">
                            Create Quote
                        </button>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
