<odoo>
<template id="gift_custom_product_page" inherit_id="website_sale.product">
<xpath expr="//section[@id='product_detail']" position="replace">
    <!-- Change ID to 'custom_product_detail' to hide from Odoo's broken Zoom JS -->
    <section id="custom_product_detail" 
             t-attf-class="oe_website_sale container my-3 my-lg-4" 
             t-att-data-view-id="view_id">
        
        <div class="gift-product-layout">
            <!-- LEFT: GALLERY -->
            <div class="gift-gallery">
                <div class="product-image-wrapper">
                    <!-- Added 'js_variant_img_target' for our manual JS swap -->
                    <img t-att-src="image_data_uri(product.image_1024)"
                         class="main-product-image js_variant_img_target"
                         t-att-data-image-id="product.id"/>
                </div>
            </div>

            <!-- CENTER: CONFIGURATOR -->
            <div class="gift-configurator">
                <h1 t-field="product.name"/>
                
                <!-- Use your custom form class -->
                <form class="o_custom_variant_form" method="POST">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <t t-foreach="product.attribute_line_ids" t-as="line">
                        <div class="config-block variant_attribute">
                            <div class="config-header">
                                <t t-esc="line.attribute_id.name"/>: 
                                <span class="selected-value"><t t-esc="line.product_template_value_ids[0].name"/></span>
                            </div>
                            <div class="variant-options">
                                <t t-foreach="line.product_template_value_ids" t-as="ptav">
                                    <label class="variant-btn">
                                        <input type="radio"
                                               class="js_custom_variant_change"
                                               t-att-name="'attr_%s' % line.attribute_id.id"
                                               t-att-value="ptav.id"
                                               t-att-data-value_name="ptav.name"/>
                                        <span t-esc="ptav.name"/>
                                    </label>
                                </t>
                            </div>
                        </div>
                    </t>
                </form>
            </div>

            <!-- RIGHT: PRICE PANEL -->
            <div class="gift-quote-panel">
                <div class="price-display">
                    <!-- We keep the Odoo call but wrap it so we can update it manually if needed -->
                    <div class="js_custom_price_wrapper">
                         <t t-call="website_sale.product_price"/>
                    </div>
                </div>
            </div>
        </div>

        <!-- Keep these hooks but change IDs slightly if needed to stop Odoo JS -->
        <div id="o_product_terms_and_share_custom"/>
        <div id="product_option_block_custom"/>
    </section>
</xpath>
</template>
</odoo>
