<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="gift_custom_product_page" inherit_id="website_sale.product">
        
        <!-- HIDE original columns reliably using ancestor -->
        <xpath expr="//div[@id='o-carousel-product']/ancestor::div[contains(@class, 'col-lg-')]" position="attributes">
            <attribute name="class" add="d-none" separator=" " />
        </xpath>

        <xpath expr="//div[@id='product_details']" position="attributes">
            <attribute name="class" add="d-none" separator=" " />
        </xpath>

        <!-- INJECT Custom 3-Column Layout -->
        <xpath expr="//section[@id='product_detail']" position="inside">
            
            <!-- TOP ORANGE BANNER -->
            <div class="gift-top-banner text-center py-2 mb-4" style="background-color: #FF8C00; color: white;">
                <div class="fw-bold">⭐ CLICK HERE FOR OUR MOST POPULAR PICKS ⭐</div>
                <div class="small">Buy tried and tested items customers love</div>
            </div>

            <div class="container-fluid px-lg-5 gift-main-body">
                <div class="row g-4 align-items-start">
                    
                    <!-- COLUMN 1: STICKY GALLERY -->
                    <div class="col-lg-5 col-12 sticky-gallery">
                        <div class="border rounded p-3 bg-white position-relative shadow-sm text-center">
                            <span class="badge rounded-pill bg-danger position-absolute top-0 end-0 m-3 p-3 z-index-1" style="font-size: 1.2rem;">15% OFF</span>
                            <div id="gift_gallery_hook"></div>
                        </div>
                    </div>

                    <!-- COLUMN 2: CONFIGURATOR (SCROLLING) -->
                    <div class="col-lg-4 col-12">
                        <h1 t-field="product.name" class="h2 fw-bold mb-1" />
                        <div class="text-muted mb-4 small">Product Code: <span t-field="product.default_code" /></div>
                        
                        <div id="gift_variant_hook" class="mb-5"></div>

                        <!-- QUANTITY GRID -->
                        <div class="gift-qty-section mt-5 border-top pt-4">
                            <h6 class="fw-bold mb-3">Quantity: 50</h6>
                            <div class="row g-2">
                                <t t-foreach="[50, 100, 250, 500]" t-as="qty">
                                    <div class="col-6 col-md-3">
                                        <div t-attf-class="tier-card p-2 border rounded text-center #{'border-primary active bg-light' if qty == 50 else ''}">
                                            <div class="fw-bold"><t t-esc="qty" />+</div>
                                            <div class="small">£<t t-esc="'%.2f' % (product.list_price * 0.85)" /></div>
                                            <div class="x-small text-muted">each</div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- COLUMN 3: QUOTE PANEL (STICKY - Blue Marked Area) -->
                    <div class="col-lg-3 col-12 sticky-sidebar">
                        <div class="gift-quote-panel border rounded p-4 bg-white shadow-sm">
                            
                            <!-- Price & VAT Toggle -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="price-display">
                                    <div class="text-muted text-decoration-line-through small">£29.15</div>
                                    <div class="h2 fw-bold text-danger mb-0">
                                        <t t-call="website_sale.product_price" />
                                    </div>
                                    <div class="x-small text-muted">per unit (exc. VAT)</div>
                                </div>
                                <div class="vat-toggle text-end">
                                    <div class="small fw-bold">Excludes VAT</div>
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" checked="checked" />
                                    </div>
                                </div>
                            </div>

                            <button class="btn btn-primary w-100 py-3 fw-bold mb-2 shadow-sm" style="background-color: #002D5B; border: none;">Add To Quote</button>
                            <button class="btn btn-warning w-100 py-2 fw-bold mb-2" style="background-color: #FFB800; border: none;">Need Ideas?</button>
                            
                            <div class="text-center small text-muted my-2">OR</div>
                            
                            <button class="btn btn-outline-secondary w-100 py-2 mb-3">Buy 1 Sample</button>
                            <div class="x-small text-center text-muted">£16.36 (non-personalised sample) +£14.9 delivery</div>

                            <!-- Satisfaction Guaranteed Section -->
                            <div class="satisfaction-box mt-4 pt-3 border-top">
                                <div class="small fw-bold text-primary mb-1">EverythingBranded Satisfaction Guaranteed</div>
                                <div class="small text-muted mb-2">Over 20,000+ reviews ⭐⭐⭐⭐⭐</div>
                                <button class="btn btn-light btn-sm w-100 mt-2 border">Chat Now</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
