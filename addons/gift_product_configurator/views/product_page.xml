<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="gift_custom_product_page" inherit_id="website_sale.product">
<!-- REPLACE default product layout -->
<xpath expr="//section[@id='product_detail']" position="inside">

    <section id="product_detail" class="oe_website_sale container my-3 my-lg-4">
            <!-- ===== TOP PROMO BANNER ===== -->

            <div class="gift-top-banner">

            <a href="/bestsellers"
            class="banner-link">

                ⭐ CLICK HERE FOR OUR MOST POPULAR PICKS ⭐
                <span>Buy tried and tested items customers love</span>

            </a>
            </div>

       
        <div class="gift-product-layout">

            <!-- ===================================== -->
            <!-- LEFT: GALLERY -->
            <!-- ===================================== -->
            <div class="gift-gallery">

                <div class="product-image-wrapper">

                    <span class="flag-badge">🇬🇧</span>
                    <span class="offer-badge">SPECIAL OFFER</span>

                    <img t-att-src="'/web/image/product.template/%s/image_1024' % product.id"
                         class="main-product-image"/>

                    <button class="nav-arrow left">‹</button>
                    <button class="nav-arrow right">›</button>

                </div>

            </div>


            <!-- ===================================== -->
            <!-- CENTER: CONFIGURATOR -->
            <!-- ===================================== -->
            <div class="gift-configurator">

                <h1 t-field="product.name"/>
                <div class="product-code">
                    Product Code: <t t-esc="product.default_code"/>
                </div>

                <!-- DYNAMIC MULTI-ATTRIBUTE VARIANTS -->
                <t t-if="product.attribute_line_ids">

                <form class="o_custom_variant_form"
                        t-att-data-product-template-id="product.id">

                    <t t-foreach="product.attribute_line_ids" t-as="line">

                    <div class="config-block"
                        t-att-data-attribute-id="line.attribute_id.id">

                        <!-- Header showing selected value -->
                        <div class="config-header">
                        <t t-esc="line.attribute_id.name"/>:
                        <span class="selected-value">
                            <t t-esc="line.product_template_value_ids[0].name"/>
                        </span>
                        </div>

                        <div class="variant-options">

                        <t t-foreach="line.product_template_value_ids" t-as="ptav">

                            <!-- COLOR ATTRIBUTE (SWATCH) -->
                            <t t-if="line.attribute_id.display_type == 'color'">

                            <label class="variant-swatch">

                                <input type="radio"
                                    class="variant-radio"
                                    name="attr_{{ line.attribute_id.id }}"
                                    t-att-value="ptav.id"
                                    t-att-data-value-name="ptav.name"
                                    t-att-checked="ptav == line.product_template_value_ids[0]"/>

                                <span class="color-circle"
                                    t-att-style="'background:' + (ptav.html_color or '#ccc')">
                                </span>

                            </label>

                            </t>

                            <!-- NON-COLOR ATTRIBUTES (BUTTON STYLE) -->
                            <t t-else="">

                            <label class="variant-btn">

                                <input type="radio"
                                    class="variant-radio"
                                    name="attr_{{ line.attribute_id.id }}"
                                    t-att-value="ptav.id"
                                    t-att-data-value-name="ptav.name"
                                    t-att-checked="ptav == line.product_template_value_ids[0]"/>

                                <span>
                                <t t-esc="ptav.name"/>
                                </span>

                            </label>

                            </t>

                        </t>

                        </div>

                    </div>

                    </t>

                </form>

                </t>

                <!-- PRINT METHOD -->
                <div class="config-block">
                    <div class="config-header">Print Method</div>
                    <select class="form-select">
                        <option>Branded</option>
                        <option>Digital</option>
                        <option>Screen Print</option>
                    </select>
                </div>

                <!-- LOGO COLOURS -->
                <div class="config-block">
                    <div class="config-header">Logo Colours</div>
                    <select class="form-select">
                        <option>1 colour</option>
                        <option>2 colours</option>
                        <option>Full colour</option>
                    </select>
                </div>

                <!-- QUANTITY TIERS -->
                <div class="config-block">

                    <div class="config-header">Quantity</div>

                    <div id="qty_tiers">

                        <div class="tier-card active">
                            <strong>50+</strong>
                            <div id="actual_price">
                                 <span class="price">£7.71</span>
                            </div>
                           
                        </div>

                        <div class="tier-card popular">
                            <strong>100+</strong>
                            <span>£5.40 each</span>
                        </div>

                        <div class="tier-card">
                            <strong>250+</strong>
                            <span>£4.80 each</span>
                        </div>

                        <div class="tier-card">
                            <strong>500+</strong>
                            <span>£4.10 each</span>
                        </div>

                    </div>

                    <div class="divider">OR</div>

                    <!-- MANUAL QTY -->
                    <div class="custom-qty">
                        <button type="button" class="qty-minus">−</button>
                        <input type="number" value="50"/>
                        <button type="button" class="qty-plus">+</button>
                    </div>

                </div>
            </div>



            <!-- ===================================== -->
            <!-- RIGHT: QUOTE PANEL -->
            <!-- ===================================== -->
            <div class="gift-quote-panel">
                <!--product price-->
                <div class="price-display">
                    <!--span class="price">£7.71</span-->
                    <span class="price">£</span><t t-call="website_sale.product_price" />
                    <div class="per-unit">per unit (exc. VAT)</div>
                </div>

                <button
                class="js-add-quote btn-quote"
                t-att-data-product-id="product.product_variant_id.id"
                t-att-data-product-name="product.name"
                t-att-data-product-image="product.image_1920 and ('/web/image/product.product/' + str(product.product_variant_id.id) + '/image_1920')"
                data-product-price="7.71"
                >
                Create Quote
                </button>

                <button class="btn-ideas">
                    Need Ideas?
                </button>

                <div class="divider">OR</div>

                <button class="btn-sample">
                    Buy 1 Sample
                </button>

            </div>

        </div>

        <!-- ===== SLIDE-IN QUOTE PANEL ===== -->
    </section>

</xpath>
</template>
</odoo>