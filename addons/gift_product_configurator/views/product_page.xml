<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="gift_custom_product_page"
          inherit_id="website_sale.product">

    <xpath expr="//div[@id='product_detail_main']" position="inside">

        <!--Your custom wrapper-->
         <div class="gift-top-banner">

              <a href="/bestsellers"
              class="banner-link">

                  ⭐ CLICK HERE FOR OUR MOST POPULAR PICKS ⭐
                  <span>Buy tried and tested items customers love</span>

              </a>
            </div>

<div id="middle_content_container_main" class="middle_content_container_main">
                <div class="gift-configurator">
                    <!--form method="post"-->
                        <!-- PRINT METHOD -->
                        <div class="config-block">
                            <div class="config-header">Print Method</div>
                            <!-- <select class="form-select" id="print_method_select"> -->
                            <select class="form-select" id="print_method_select" name="print_method">
                                <option value="branded" >Branded</option>
                                <option value="non-branded">Non-Branded</option>
                            </select>
                        </div> 

                       <div class="branding-fields">
                         <!-- LOGO COLOURS -->
                            <div class="config-block">
                                <div class="config-header">Logo Colours</div>
                                <!-- <select class="form-select"> -->
                                <select class="form-select" id="logo_colours_select" name="logo_colours">
                                    <option>1 colour</option>
                                    <option>2 colours</option>
                                    <option>Full colour</option>
                                </select>
                            </div>

                            <!-- QUANTITY TIERS -->
                            <div class="config-block">

                                <div class="config-header">Quantity</div>

                                <div class="qty_wrapper d-flex">
                                    <div id="qty_tiers">
                                    

                                            <t t-set="pricing_tiers"
                                                t-value="product.get_website_pricing()"/>

                                                <div style="background:#ffffcc;padding:10px;border:1px solid #999;">

                                                    Pricing Tier Count:

                                                    <t t-esc="len(pricing_tiers)"/>

                                                </div>

                                                <t t-foreach="pricing_tiers"
                                                t-as="tier"
                                                t-key="tier['sequence']">

                                                    <div
                                                        t-attf-class="tier-card qty_tiers_card #{'active' if tier_index == 0 else ''}"
                                                        t-att-data-tier="json.dumps(tier)">

                                                        <strong>

                                                            <t t-esc="tier['quantity']"/>+

                                                        </strong>

                                                        <div
                                                            t-att-id="'actual_price' if tier_index == 0 else None">

                                                            <span class="price">

                                                                <t t-esc="tier['formatted_price']"/>

                                                            </span>

                                                            <t t-if="tier_index == 0">

                                                                each

                                                            </t>

                                                        </div>

                                                    </div>

                                                </t>    

                                            
                                            
                                            <!--larger qty-->
                                            <div class="qty_tiers_card">
                                            <a href="/larger-quantity">
                                                    <div>
                                                        <span>Larger order?</span>
                                                        <span> Get an express quote now →</span>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                
                                    </div>
                                <!-- QUANTITY TIERS -->

                                        <div class="qty_divider">OR</div>

                                        <!-- MANUAL QTY -->
                                        <div class="custom-qty">
                                            <button type="button" class="qty-minus">−</button>
                                            <input type="number" placeholder="Enter Custom Value" value="50"/>
                                            <button type="button" class="qty-plus">+</button>
                                        </div>
                                </div>
                            </div>
                        </div>
</div>

             <!-- ===================================== -->
            <!-- RIGHT: QUOTE PANEL -->
            <!-- ===================================== -->
            <div id="add-to-quote-deal">
                 <div class="gift-quote-panel">
                <!--product price-->
                <div class="price-display">
                    <!--span class="price">£7.71</span-->
                   <span id="dynamic_main_price" class="price">
                        <t t-call="website_sale.product_price" />
                    </span>
                    <div class="per-unit">per unit (exc. VAT)</div>
                </div>

                <!-- <button
                class="js-add-quote btn-quote"
                t-att-data-product-id="product.product_variant_id.id"
                t-att-data-product-name="product.name"
                t-att-data-product-image="product.image_1920 and ('/web/image/product.product/' + str(product.product_variant_id.id) + '/image_1920')"
                t-att-data-product-price="product.product_variant_id.lst_price"
                > -->
                <button
                    class="js-add-quote btn-quote"

                    t-att-data-product-id="product.product_variant_id.id"

                    t-att-data-product-name="product.name"

                    t-att-data-product-image="product.image_1920 and ('/web/image/product.product/' + str(product.product_variant_id.id) + '/image_1920')"

                    t-att-data-product-price="product.product_variant_id.lst_price"

                    t-att-data-product-sku="product.default_code or ''"

                    t-att-data-product-url="request.httprequest.url"

                    t-att-data-currency="'GBP'">
                Create Quote
                </button>

                <button class="btn-ideas">
                    Need Ideas?
                </button>

                <div class="qty_divider">OR</div>

                <button
                class="btn-sample js-add-sample"
                t-att-data-product-id="product.product_variant_id.id"
                t-att-data-product-name="product.name"
                t-att-data-product-price="product.product_variant_id.lst_price"
                t-att-data-product-image="product.image_1920 and ('/web/image/product.product/' + str(product.product_variant_id.id) + '/image_1920')"
                >
                Buy 1 Sample
                </button>

            </div>
            </div>

    </xpath>


    <xpath expr="//div[@id='product_details']//t[@t-call='website_sale.product_price']"
    position="after">

        <!-- ===================================== -->
        <!-- PRODUCT EXTRA DETAILS -->
        <!-- ===================================== -->

        <div class="gift-product-extra-details"
            t-if="product.description_sale">

            <div t-raw="product.description_sale" 
                class="product-rich-description"/>

        </div>

    </xpath>


</template>
</odoo>