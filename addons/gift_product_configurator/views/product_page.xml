<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="gift_custom_product_page" inherit_id="website_sale.product">
        <!-- Hide the original details column but keep it in DOM to prevent JS crashes -->
        <xpath expr="//div[@id='product_details']" position="attributes">
            
            <attribute name="class" add="d-none" separator=" " />

        </xpath>

        <!-- Inject the new 3-column layout -->
        <xpath expr="//section[@id='product_detail']" position="inside">
            <div class="gift-main-wrapper container mt-4">
                <div class="row g-4">
                    
                    <!-- COLUMN 1: GALLERY -->
                    <div class="col-lg-5 col-12">
                        <div class="gift-gallery-card border rounded p-3 position-relative bg-white h-100">
                            <span class="badge rounded-pill bg-danger position-absolute top-0 end-0 m-3 z-index-1" style="font-size: 1.2rem; padding: 15px;">15% OFF</span>
                            <div id="gift_gallery_hook">
                                <!-- Odoo's native #o-carousel-product will be moved here by JS -->
                            </div>
                        </div>
                    </div>

                    <!-- COLUMN 2: CONFIGURATOR -->
                    <div class="col-lg-4 col-12">
                        <div class="gift-configurator-card h-100">
                            <h1 t-field="product.name" class="h3 fw-bold mb-1"/>
                            <div class="text-muted mb-4 small">
                                Product Code: <span t-field="product.default_code"/>
                            </div>
                            
                            <div id="gift_variant_hook">
                                <!-- Odoo's native .js_add_cart_variants will be moved here by JS -->
                            </div>

                            <!-- QUANTITY TIERS (MATCHING SCREENSHOT) -->
                            <div class="gift-quantity-grid mt-4">
                                <div class="row g-2">
                                    <t t-foreach="[50, 100, 250, 500]" t-as="qty">
                                        <div class="col-6">
                                            <div class="tier-card p-2 border rounded text-center">
                                                <div class="fw-bold"><t t-esc="qty"/>+</div>
                                                <div class="small text-muted">£7.71 each</div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- COLUMN 3: QUOTE PANEL -->
                    <div class="col-lg-3 col-12">
                        <div class="gift-quote-card shadow-sm border rounded p-3 bg-white h-100">
                            <div class="price-section mb-4">
                                <t t-call="website_sale.product_price"/>
                                <div class="small text-muted">per unit (exc. VAT)</div>
                            </div>
                            
                            <button class="btn btn-primary w-100 py-3 fw-bold mb-3 shadow-sm" style="background-color: #002D5B;">Book A Call Back</button>
                            
                            <div class="trustpilot-box border-top pt-3 mt-3">
                                <div class="small text-muted mb-2">Showing our 5 star reviews</div>
                                <div class="testimonial border-start border-4 border-success ps-2 mb-3">
                                    <div class="fst-italic small">"Excellent service from start to finish..."</div>
                                    <div class="fw-bold x-small mt-1">James Dickinson, 2 days ago</div>
                                </div>
                                <img src="https://upload.wikimedia.org" style="height: 20px; opacity: 0.7;"/>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </xpath>
    </template>
</odoo>
