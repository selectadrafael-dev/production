<odoo>
<template id="gift_custom_product_page" inherit_id="website_sale.product">
<!-- REPLACE default product layout -->
<xpath expr="//section[@id='product_detail']" position="inside">

    <section id="product_detail" class="oe_website_sale container my-3 my-lg-4">

        <div class="gift-product-layout">

            <!-- ===================================== -->
            <!-- LEFT: GALLERY -->
            <!-- ===================================== -->
            <div class="gift-gallery">

                <div class="product-image-wrapper">

                    <span class="flag-badge">🇬🇧</span>
                    <span class="offer-badge">SPECIAL OFFER</span>

                    <img t-att-src="'/web/image/product.template/%s/image_1024' % product.id"
                         class="main-product-image"/>

                    <button class="nav-arrow left">‹</button>
                    <button class="nav-arrow right">›</button>

                </div>

            </div>


            <!-- ===================================== -->
            <!-- CENTER: CONFIGURATOR -->
            <!-- ===================================== -->
            <div class="gift-configurator">

                <!-- PROMO BANNER -->
                <div class="promo-banner">
                    CLICK HERE FOR OUR MOST POPULAR PICKS
                </div>

                <!-- PRODUCT NAME -->
                <h1 t-field="product.name"/>

                <!-- PRODUCT CODE -->
                <div class="product-code">
                    Product Code:
                    <t t-esc="product.default_code"/>
                </div>


                <!-- ============================= -->
                <!-- VARIANT SELECTOR BLOCKS -->
                <!-- ============================= -->
              

                <div class="variant-section">
                    <t t-foreach="product.attribute_line_ids" t-as="attr">

                        <div class="config-block">

                            <!-- HEADER -->
                            <div class="config-header">
                                <span t-esc="attr.attribute_id.name"/>
                                <span class="chevron">⌄</span>
                            </div>

                            <!-- BODY -->
                            <div class="config-body">

                                <!-- PRINT METHOD → DROPDOWN -->
                                <t t-if="attr.attribute_id.name == 'Print Method'">

                                    <select class="print-method-dropdown">

                                        <t t-foreach="attr.value_ids" t-as="value">
                                            <option t-att-value="value.id">
                                                <t t-esc="value.name"/>
                                            </option>
                                        </t>

                                    </select>

                                </t>

                                <!-- OTHER ATTRIBUTES → BUTTONS -->
                                <t t-else="">

                                    <div class="variant-options">

                                        <t t-foreach="attr.value_ids" t-as="value">

                                            <button type="button"
                                                    class="variant-option"
                                                    t-att-data-attr="attr.attribute_id.id"
                                                    t-att-data-value="value.id">

                                                <t t-esc="value.name"/>

                                            </button>

                                        </t>

                                    </div>

                                </t>

                            </div>

                        </div>

                    </t>
                </div>



                <!-- ============================= -->
                <!-- QUANTITY + TIERS BLOCK -->
                <!-- ============================= -->
                <div class="config-block">

                    <!-- HEADER -->
                    <div class="config-header">
                        Quantity: 50
                        <span class="chevron">⌄</span>
                    </div>

                    <!-- BODY -->
                    <div class="config-body">

                        <!-- TIER CARDS WILL RENDER HERE -->
                        <div id="qty_tiers"></div>

                        <div class="or-divider">OR</div>

                        <!-- CUSTOM QUANTITY INPUT -->
                        <div class="custom-qty">
                            <button type="button" class="qty-minus">−</button>
                            <input type="number" value="50"/>
                            <button type="button" class="qty-plus">+</button>
                        </div>

                    </div>

                </div>

            </div>


            <!-- ===================================== -->
            <!-- RIGHT: QUOTE PANEL -->
            <!-- ===================================== -->
            <div class="gift-quote-panel">

                <div class="price-display">
                    <span class="price">£7.71</span>
                    <div class="per-unit">per unit (exc. VAT)</div>
                </div>

                <button class="btn-quote">
                    Add To Quote
                </button>

                <button class="btn-ideas">
                    Need Ideas?
                </button>

                <div class="divider">OR</div>

                <button class="btn-sample">
                    Buy 1 Sample
                </button>

            </div>

        </div>

    </section>

</xpath>
</template>
</odoo>
