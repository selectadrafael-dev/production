<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="gift_custom_product_page" inherit_id="website_sale.product">
    <!-- Replace default product layout -->
    <xpath expr="//section[@id='product_detail']" position="replace">


    <!--section id="product_detail" class="oe_website_sale container my-3 my-lg-4"-->
    <section class="oe_website_sale container my-3 my-lg-4">

        <!-- ===== TOP PROMO BANNER ===== -->
        <div class="gift-top-banner">
            <a href="/bestsellers" class="banner-link">
                ⭐ CLICK HERE FOR OUR MOST POPULAR PICKS ⭐
                <span>Buy tried and tested items customers love</span>
            </a>
        </div>

        <div class="gift-product-layout">

            <!-- LEFT: GALLERY -->
            <div class="gift-gallery">
                <div class="product-image-wrapper">
                    <span class="flag-badge">🇬🇧</span>
                    <span class="offer-badge">SPECIAL OFFER</span>

                    <img t-att-src="'/web/image/product.template/%s/image_1024' % product.id"
                         class="main-product-image"/>

                    <button class="nav-arrow left">‹</button>
                    <button class="nav-arrow right">›</button>
                </div>
            </div>

            <!-- CENTER: CONFIGURATOR -->
            <div class="gift-configurator">

                <h1 t-field="product.name"/>
                <div class="product-code">
                    Product Code: <t t-esc="product.default_code"/>
                </div>

                <!-- REAL ODOO PRODUCT FORM -->
<div class="js_product js_main_product"
     t-att-data-product-template-id="product.id">

    <form action="/shop/cart/update"
          method="POST"
          class="oe_website_sale">

        <!-- CSRF -->
        <input type="hidden"
               name="csrf_token"
               t-att-value="request.csrf_token()"/>

        <!-- REQUIRED HIDDEN FIELDS -->
        <input type="hidden"
               name="product_template_id"
               t-att-value="product.id"/>

        <input type="hidden"
               name="product_id"
               t-att-value="product.product_variant_id.id"/>


        <!-- VARIANT CONTAINER -->
        <ul class="list-unstyled js_add_cart_variants"
            t-att-data-attribute_exclusions="product._get_attribute_exclusions()"
            t-att-data-parent_exclusions="{}"
            t-att-data-archived_combinations="[]">

            <t t-foreach="product.attribute_line_ids" t-as="line">

                <li class="variant_attribute"
                    t-att-data-attribute_id="line.attribute_id.id"
                    t-att-data-attribute_name="line.attribute_id.name"
                    t-att-data-attribute_display_type="line.attribute_id.display_type">

                    <div class="config-block">

                        <!-- ATTRIBUTE HEADER -->
                        <div class="config-header">
                            <t t-esc="line.attribute_id.name"/>:
                            <span class="selected-value">
                                <t t-esc="line.product_template_value_ids[0].name"/>
                            </span>
                        </div>


                        <!-- ATTRIBUTE OPTIONS -->
                        <div class="variant-options">

                            <t t-foreach="line.product_template_value_ids" t-as="ptav">

                                <t t-set="checked"
                                   t-value="ptav.id in product.product_variant_id.product_template_attribute_value_ids.ids"/>

                                <!-- COLOR SWATCH -->
                                <t t-if="line.attribute_id.display_type == 'color'">

                                    <label class="variant-swatch">

                                        <input type="radio"
                                               class="js_variant_change variant-radio"
                                               t-att-name="'ptal-%s' % line.attribute_id.id"
                                               t-att-value="ptav.id"
                                               t-att-data-attribute_value_id="ptav.id"
                                               t-att-data-value_name="ptav.name"
                                               t-att-checked="checked"/>

                                        <span class="color-circle"
                                              t-att-style="'background:' + (ptav.html_color or '#ccc')">
                                        </span>

                                    </label>

                                </t>

                                <!-- BUTTON STYLE ATTRIBUTES -->
                                <t t-else="">

                                    <label class="variant-btn">

                                        <input type="radio"
                                               class="js_variant_change variant-radio"
                                               t-att-name="'ptal-%s' % line.attribute_id.id"
                                               t-att-value="ptav.id"
                                               t-att-data-attribute_value_id="ptav.id"
                                               t-att-data-value_name="ptav.name"
                                               t-att-checked="checked"/>

                                        <span>
                                            <t t-esc="ptav.name"/>
                                        </span>

                                    </label>

                                </t>

                            </t>

                        </div>

                    </div>

                </li>

            </t>

        </ul>

    </form>

</div>

                <!-- PRINT METHOD -->
                <div class="config-block">
                    <div class="config-header">Print Method</div>
                    <select class="form-select">
                        <option>Branded</option>
                        <option>Digital</option>
                        <option>Screen Print</option>
                    </select>
                </div>

                <!--LOGO COLOURS-->
                <div class="config-block">
                    <div class="config-header">Logo Colours</div>
                    <select class="form-select">
                        <option>1 colour</option>
                        <option>2 colours</option>
                        <option>Full colour</option>
                    </select>
                </div>

            </div>

            <!--RIGHT: QUOTE PANEL-->
            <div class="gift-quote-panel">

                <div class="price-display">
                    <span class="price">£7.71</span>
                    <div class="per-unit">per unit (exc. VAT)</div>
                </div>

                <button class="js-add-quote btn-quote"
                        t-att-data-product-id="product.product_variant_id.id"
                        t-att-data-product-name="product.name">
                    Create Quote
                </button>

                <button class="btn-ideas">Need Ideas?</button>

                <div class="divider">OR</div>

                <button class="btn-sample">
                    Buy 1 Sample
                </button>

            </div>

        </div>

        <div id="o_product_terms_and_share" style="display:none"></div>

    </section>

    </xpath>

</template>

</odoo>