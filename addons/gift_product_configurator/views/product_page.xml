<xpath expr="//section[@id='product_detail']" position="inside">
    <section id="product_detail" class="oe_website_sale container my-3 my-lg-4" 
             t-att-data-view-id="view_id"> <!-- Critical for JS context -->
        
        <div class="gift-product-layout">
            <!-- LEFT: GALLERY -->
            <div class="gift-gallery">
                <div class="product-image-wrapper">
                    <!-- Added 'js_variant_img' class for Odoo to target -->
                    <img t-if="product.image_1024"
                         t-att-src="image_data_uri(product.image_1024)"
                         class="main-product-image oe_variant_img_main"
                         t-att-data-image-id="product.id"/>
                </div>
            </div>

            <!-- CENTER: CONFIGURATOR -->
            <div class="gift-configurator">
                <h1 t-field="product.name"/>
                
                <!-- Wrap in Odoo's functional class -->
                <div class="js_add_cart_variants" t-att-data-attribute_values="json.dumps(product._get_attributes_values())">
                    <form class="o_custom_variant_form">
                        <t t-foreach="product.attribute_line_ids" t-as="line">
                            <div class="config-block variant_attribute">
                                <div class="config-header">
                                    <t t-esc="line.attribute_id.name"/>
                                </div>
                                <div class="variant-options">
                                    <t t-foreach="line.product_template_value_ids" t-as="ptav">
                                        <label t-attf-class="variant-btn #{'active' if ptav == line.product_template_value_ids[0] else ''}">
                                            <input type="radio"
                                                   class="js_variant_change"
                                                   t-att-name="'attr_%s' % line.attribute_id.id"
                                                   t-att-value="ptav.id"
                                                   t-att-data-value_id="ptav.id"
                                                   t-att-checked="ptav == line.product_template_value_ids[0]"/>
                                            <span t-esc="ptav.name"/>
                                        </label>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </form>
                </div>
            </div>

            <!-- RIGHT: PRICE PANEL -->
            <div class="gift-quote-panel">
                <div class="price-display">
                    <!-- Use Odoo's price helper to ensure auto-updates -->
                    <t t-call="website_sale.product_price"/>
                </div>
            </div>
        </div>
    </section>
</xpath>
