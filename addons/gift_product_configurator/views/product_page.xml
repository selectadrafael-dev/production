              <a href="/bestsellers"
              class="banner-link">

                  ⭐ CLICK HERE FOR OUR MOST POPULAR PICKS ⭐
                  <span>Buy tried and tested items customers love</span>

              </a>
            </div>

    </xpath>

</template>
</odoo>