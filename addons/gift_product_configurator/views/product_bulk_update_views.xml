<?xml version="1.0" encoding="utf-8"?>
<odoo>
 
<!-- Wizard Form View -->
<record id="view_product_mass_update_wizard_form"
        model="ir.ui.view">

    <field name="name">
        product.bulk.update.wizard.form
    </field>

    <field name="model">
        product.bulk.update.wizard
    </field>

    <field name="arch"
           type="xml">

        <form string="Mass Update Products">

            <sheet>

                <group string="Publishing Configuration">

                    <field name="update_publish"/>

                    <field name="is_published"
                           invisible="not update_publish"/>

                </group>

                <group string="Price Configuration">

                    <field name="update_price"/>

                    <field name="price_change_type"
                           widget="radio"
                           invisible="not update_price"/>

                    <field name="price_value"
                           invisible="not update_price"/>

                </group>

            </sheet>

            <footer>

                <button
                    name="action_apply_mass_update"
                    type="object"
                    string="Apply Changes"
                    class="btn-primary"/>

                <button
                    string="Cancel"
                    special="cancel"
                    class="btn-secondary"/>

            </footer>

        </form>

    </field>

</record>


<!-- Window Action -->

<record id="action_product_mass_update_wizard"
        model="ir.actions.act_window">

    <field name="name">
        Mass Update
    </field>

    <field name="res_model">
        product.bulk.update.wizard
    </field>

    <field name="view_mode">
        form
    </field>

    <field name="target">
        new
    </field>

</record>


<!-- Action Menu Item -->

<record id="action_server_product_mass_update"
        model="ir.actions.server">

    <field name="name">
        Mass Update
    </field>

    <field name="model_id"
           ref="product.model_product_template"/>

    <field name="binding_model_id"
           ref="product.model_product_template"/>

    <field name="binding_type">
        action
    </field>

    <field name="binding_view_types">
        list
    </field>

    <field name="state">
        code
    </field>

    <field name="code"><![CDATA[action = env.ref(
'gift_product_configurator.action_product_mass_update_wizard'
).read()[0]
]]></field>

</record>
</odoo>


