<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard View Definition -->
    <record id="view_product_mass_update_wizard_form" model="ir.ui.view">
        <name>product.bulk.update.wizard.form</name>
        <model>product.bulk.update.wizard</model>
        <arch type="xml">
            <form string="Mass Update Products">
                <sheet>
                    <group string="Publishing Configuration">
                        <field name="update_publish"/>
                        <field name="is_published" invisible="not update_publish"/>
                    </group>
                    
                    <group string="Price Configuration">
                        <field name="update_price"/>
                        <field name="price_change_type" invisible="not update_price" widget="radio"/>
                        <field name="price_value" invisible="not update_price"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Apply Changes" name="action_apply_mass_update" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </arch>
    </record>

    <!-- Contextual Action to Trigger Wizard Form View -->
    <record id="action_product_mass_update_wizard" model="ir.actions.act_window">
        <name>Mass Update</name>
        <res_model>product.bulk.update.wizard</res_model>
        <view_mode>form</view_mode>
        <target>new</target> <!-- This opens the form as a Modal Box Popup -->
    </record>

    <!-- Binding Action Server to Action Dropdown Menu -->
    <record id="action_server_product_mass_update" model="ir.actions.server">
        <name>Mass Update</name>
        <model_id ref="product.model_product_template"/>
        <binding_model_id ref="product.model_product_template"/>
        <binding_view_types>list</binding_view_types>
        <state>code</state>
        <code(s)>
action = env.ref('gift_product_configurator.action_product_mass_update_wizard').read()[0]
        </code(s)>
    </record>
</odoo>
