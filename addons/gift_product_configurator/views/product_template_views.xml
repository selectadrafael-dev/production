<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_search_vendor"
            model="ir.ui.view">

        <field name="name">product.template.search.vendor</field>

        <field name="model">product.template</field>

        <field name="inherit_id"
               ref="product.product_template_search_view"/>

        <field name="arch"
               type="xml">

            <xpath expr="//search"
                   position="inside">

                <field name="vendor_id"/>

                <field name="vendor_fingerprint"/>

            </xpath>

            <xpath expr="//group"
                   position="inside">

                <filter
                    string="Vendor"
                    name="group_by_vendor"
                    context="{'group_by':'vendor_id'}"/>

            </xpath>

        </field>

    </record>

</odoo>