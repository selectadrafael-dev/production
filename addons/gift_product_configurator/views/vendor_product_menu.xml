<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================= -->
    <!-- VENDOR PRODUCT LIST VIEW -->
    <!-- ========================================= -->

    <record id="vendor_product_tree_view"
            model="ir.ui.view">

        <field name="name">vendor.product.tree</field>

        <field name="model">product.template</field>

        <field name="arch"
               type="xml">

            <list>

                <field name="name"/>

                <field name="default_code"/>

                <field
                    name="public_categ_ids"
                    widget="many2many_tags"
                    optional="show"
                />

                <field name="list_price"/>

                <field name="vendor_stock_qty"/>

                <field
                    name="website_published"
                    optional="show"
                />

                <field
                    name="show_available_qty"
                    optional="show"
                />

                <field
                    name="allow_out_of_stock_order"
                    optional="show"
                />

            </list>

        </field>

    </record>


    <!-- ========================================= -->
    <!-- VENDOR PRODUCTS ACTION -->
    <!-- ========================================= -->

    <record id="action_vendor_products"
            model="ir.actions.act_window">

        <field name="name">Vendor Products</field>

        <field name="res_model">product.template</field>

        <field name="view_mode">list,form</field>

        <field name="view_id"
               ref="vendor_product_tree_view"/>

        <field name="domain">
            []
        </field>

        <field name="context">
            {}
        </field>

    </record>


    <!--=========================================-->
    <!-- VENDOR MENU -->
    <!--=========================================-->

    <menuitem
        id="menu_vendor_products"
        name="Products"
        parent="website_sale.menu_ecommerce"
        action="action_vendor_products"
        sequence="1"
        groups="gift_product_configurator.group_product_vendor"
    />

</odoo>