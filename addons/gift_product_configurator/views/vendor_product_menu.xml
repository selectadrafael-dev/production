<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vendor Products Action -->
    <record id="action_vendor_products"
            model="ir.actions.act_window">

        <field name="name">Vendor Products</field>

        <field name="res_model">product.template</field>

        <field name="view_mode">kanban,tree,form</field>

        <!-- Optional safer domain -->
        <field name="domain">
            [('vendor_id', '=', user.partner_id.id)]
        </field>

    </record>

    <!-- Vendor Products Menu -->
    <menuitem
        id="menu_vendor_products"
        name="Products"
        parent="website_sale.menu_ecommerce"
        action="action_vendor_products"
        sequence="1"
        groups="gift_product_configurator.group_product_vendor"
    />

</odoo>