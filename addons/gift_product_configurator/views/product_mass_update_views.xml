<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record
        id="view_product_mass_update_wizard"
        model="ir.ui.view"
        >

        <field name="name">
            product.mass.update.wizard.form
        </field>

        <field name="model">
            product.mass.update.wizard
        </field>

        <field name="arch"
               type="xml">

            <form
                string="Mass Update Products">

                <group>

                    <group>

                        <field
                            name="publish_products"/>

                        <field
                            name="unpublish_products"/>

                    </group>

                </group>

                <separator
                    string="Price Update"/>

                <group>

                    <field
                        name="update_price"/>

                    <field
                        name="update_method"
                        attrs="{
                        'invisible':
                        [('update_price','=',False)]
                        }"/>

                    <field
                        name="operation"
                        attrs="{
                        'invisible':
                        [('update_price','=',False)]
                        }"/>

                    <field
                        name="value"
                        attrs="{
                        'invisible':
                        [('update_price','=',False)]
                        }"/>

                </group>

                <footer>

                    <button
                        name="action_apply"
                        type="object"
                        string="Apply"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"/>

                </footer>

            </form>

        </field>
    </record>
</odoo>