<odoo>

    <!-- ACTION -->
    <record id="action_vendor_import_job" model="ir.actions.act_window">
        <field name="name">Vendor Imports</field>
        <field name="res_model">vendor.import.job</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- MENU ROOT -->
    <!-- <menuitem id="menu_vendor_root"
              name="Vendor Data"
              sequence="10"/> -->


    <!-- MENU CHILD -->
    <!-- <menuitem id="menu_vendor_imports"
              name="Imports"
              parent="menu_vendor_root"
              action="action_vendor_import_job"
              sequence="10"/> -->


    <!-- MENU ROOT -->
    <menuitem id="menu_vendor_root"
            name="Vendor Data"
            parent="base.menu_administration"
            sequence="90"/>

    <!-- MENU CHILD -->
    <menuitem id="menu_vendor_imports"
            name="Imports"
            parent="menu_vendor_root"
            action="action_vendor_import_job"
            sequence="10"/>

    <!-- LIST VIEW -->
    <record id="view_vendor_import_job_list" model="ir.ui.view">
        <field name="name">vendor.import.job.list</field>
        <field name="model">vendor.import.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>


    <!-- FORM VIEW -->
    <record id="view_vendor_import_job_form" model="ir.ui.view">
        <field name="name">vendor.import.job.form</field>
        <field name="model">vendor.import.job</field>
        <field name="arch" type="xml">
            <form string="Vendor Import Job">

                <!-- 🔥 HEADER (BUTTON GOES HERE) -->
                <header>
                    <button name="action_reset_jobs"
                            type="object"
                            string="Reset Import Jobs"
                            class="btn-danger"
                            confirm="This will delete ALL import jobs and reset ID. Continue?"/>
                </header>

                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="state"/>
                        <field name="data_url"/>
                        <field name="extra_info"/>
                    </group>

                    <notebook>

                        <page string="AI Data">
                            <field name="extracted_text" widget="text"/>
                            <field name="current_page" invisible="1"/>
                            <field name="ai_response" widget="text"/>
                        </page>

                        <page string="Files">
                            <field name="pdf_file" filename="name"/>
                            <field name="excel_file"/>
                            <field name="logo_file"/>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>