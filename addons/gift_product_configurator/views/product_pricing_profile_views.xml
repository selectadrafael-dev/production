<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- SEARCH VIEW -->
    <!-- ========================================================= -->

    <record id="view_product_pricing_profile_search"
            model="ir.ui.view">

        <field name="name">product.pricing.profile.search</field>

        <field name="model">product.pricing.profile</field>

        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="owner_partner_id"/>

                <field name="usage"/>

                <filter
                    string="Active"
                    name="active"
                    domain="[('active','=',True)]"/>

                <filter
                    string="Default"
                    name="default_profile"
                    domain="[('is_default','=',True)]"/>

                <group expand="0" string="Group By">

                    <filter
                        string="Owner"
                        context="{'group_by':'owner_partner_id'}"/>

                    <filter
                        string="Usage"
                        context="{'group_by':'usage'}"/>

                </group>

            </search>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- TREE VIEW -->
    <!-- ========================================================= -->

    <record id="view_product_pricing_profile_tree"
            model="ir.ui.view">

        <field name="name">product.pricing.profile.tree</field>

        <field name="model">product.pricing.profile</field>

        <field name="arch" type="xml">

            <tree>

                <field name="name"/>

                <field name="usage"/>

                <field name="owner_partner_id"/>

                <field name="company_id"/>

                <field name="is_default"/>

                <field name="product_count"/>

                <field name="active"/>

            </tree>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- FORM VIEW -->
    <!-- ========================================================= -->

    <record id="view_product_pricing_profile_form"
            model="ir.ui.view">

        <field name="name">product.pricing.profile.form</field>

        <field name="model">product.pricing.profile</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <div class="oe_title">

                        <label for="name"/>

                        <h1>

                            <field name="name"/>

                        </h1>

                    </div>

                    <!-- ===================================== -->
                    <!-- INFORMATION -->
                    <!-- ===================================== -->

                    <group>

                        <group>

                            <field name="usage"/>

                            <field name="owner_partner_id"/>

                            <field name="company_id"/>

                        </group>

                        <group>

                            <field name="is_default"/>

                            <field name="active"/>

                            <field
                                name="product_count"
                                readonly="1"/>

                        </group>

                    </group>

                    <!-- ===================================== -->
                    <!-- DESCRIPTION -->
                    <!-- ===================================== -->

                    <group>

                        <field
                            name="description"
                            placeholder="Internal notes..."/>

                    </group>

                    <!-- ===================================== -->
                    <!-- PRICING TIERS -->
                    <!-- ===================================== -->

                    <notebook>

                        <page string="Pricing Tiers">

                            <field name="tier_line_ids">

                                <tree editable="bottom">

                                    <field
                                        name="sequence"
                                        widget="handle"/>

                                    <field
                                        name="minimum_quantity"/>

                                    <field
                                        name="discount_percent"/>

                                    <field
                                        name="notes"/>

                                    <field
                                        name="active"/>

                                </tree>

                            </field>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- ACTION -->
    <!-- ========================================================= -->

    <record id="action_product_pricing_profile"
            model="ir.actions.act_window">

        <field name="name">Pricing Profiles</field>

        <field name="res_model">product.pricing.profile</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id"
               ref="view_product_pricing_profile_search"/>

        <field name="help"
               type="html">

            <p class="o_view_nocontent_smiling_face">

                Create your first pricing profile.

            </p>

            <p>

                Pricing Profiles allow vendors and administrators
                to define reusable quantity discount structures
                that can later be applied to products individually,
                through Mass Update, or automatically during
                catalogue imports.

            </p>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- MENU -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_product_pricing_profile"
        name="Pricing Profiles"
        parent="product.menu_catalog"
        action="action_product_pricing_profile"
        sequence="80"/>

</odoo>