<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_vendor_visibility_rule"
            model="ir.rule">

        <field name="name">
            Vendor Own Products
        </field>

        <field name="model_id"
               ref="product.model_product_template"/>

        <field name="groups"
               eval="[(4, ref('gift_product_configurator.group_product_vendor'))]"/>

        <field name="domain_force">

            [
                ('vendor_id', '=', user.partner_id.id)
            ]

        </field>

        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>

    </record>

</odoo>