<odoo>
    <template id="vendor_modal_global_inherit" inherit_id="website.layout">

        <!-- Inject modal into EVERY page -->
        <xpath expr="//body" position="inside">
            <t t-call="theme_gifting.vendor_data.modal"/>
        </xpath>

    </template>

    <!-- Modal Template -->
   <template id="vendor_data_modal_template">
         <!--vendor data modalbox-->
     <t t-name="theme_gifting.vendor_data.modal">
          <div class="modal fade" id="vendorDataModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
              <div class="modal-content vendor-modal">

                <div class="modal-header">
                  <h5 class="modal-title">Upload Vendor Product Data</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                   <!--progress bar -->
                <div id="uploadProgressWrapper" class="progress mb-3 d-none" style="height:26px;">
                  <div id="uploadProgressBar"
                      class="progress-bar progress-bar-striped progress-bar-animated"
                      role="progressbar"
                      style="width:0%">
                      
                      <span id="uploadPercentText">0%</span>
                  </div>
                </div>

                  <!-- ERROR BOX -->
                  <div id="vendorSuccessBox"
                      class="alert alert-success d-none mb-3">
                  </div>

                  <div id="vendorErrorBox"
                      class="alert alert-danger d-none mb-3">
                  </div>
                  
                  <form id="vendorDataForm"
                      enctype="multipart/form-data">

                    <input type="hidden"
                    name="csrf_token"
                    t-att-value="request.csrf_token()"/>
                  
                    <div class="mb-4">
                      <label class="form-label fw-semibold">Vendor Website / Data URL</label>
                      <input type="url" class="form-control"
                            placeholder="https://vendor-site.com/catalog" name="data_url" />
                    </div>

                     <div class="text-center mb-3 text-muted">— OR —</div>

                
                    <div class="row g-3">

                      <div class="col-md-6">
                        <div class="upload-card">
                          <label class="upload-label">Upload PDF Catalog</label>
                          <input type="file" accept=".pdf" name="pdf_file" class="form-control"/>
                        </div>
                      </div>

                    
                      <div class="col-md-6">
                        <div class="upload-card">
                          <label class="upload-label">Upload Excel / CSV</label>
                          <input type="file" name="excel_file" accept=".xls,.xlsx,.csv" class="form-control"/>
                        </div>
                      </div>

                    
                      <div class="col-md-12 vendor_logo">
                        <div class="upload-card">
                          <label class="upload-label">Vendor Logo (optional)</label>
                          <input type="file" name="logo_file" accept="image/*" class="form-control"/>
                        </div>
                      </div>

                    </div>

                    <div class="mt-4">
                      <label class="form-label fw-semibold">
                        Additional Information (Optional)
                      </label>
                      <textarea name="extra_info" class="form-control" rows="4"
                        placeholder="Provide pricing notes, MOQ, printing methods, special instructions, etc."></textarea>
                    </div>

                    <div class="modal-footer">
                      <button type="submit" class="btn btn-outline-secondary"
                              data-bs-dismiss="modal">Cancel</button>
                      <button class="btn btn-primary px-4">
                        Submit Data
                      </button>
                    </div>

                </form>
                </div>

              </div>
            </div>
          </div>
         </t>
    </template>
</odoo>