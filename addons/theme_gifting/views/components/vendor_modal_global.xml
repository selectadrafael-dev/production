
<!---working modal-->
<odoo>
  <template id="selectad_global_modals" inherit_id="website.layout">
    <xpath expr="//body" position="inside">
         <!--vendor data modalbox-->
        <!--t t-name="vendor_data.modal"-->
          <div class="modal fade" id="vendorDataModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
              <div class="modal-content vendor-modal">

                <div class="modal-header">
                  <h5 class="modal-title">Upload Vendor Product Data</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                   <!--progress bar -->
                <div id="uploadProgressWrapper" class="progress mb-3 d-none" style="height:26px;">
                  <div id="uploadProgressBar"
                      class="progress-bar progress-bar-striped progress-bar-animated"
                      role="progressbar"
                      style="width:0%">
                      
                      <span id="uploadPercentText">0%</span>
                  </div>
                </div>

                  <!-- ERROR BOX -->
                  <div id="vendorSuccessBox"
                      class="alert alert-success d-none mb-3">
                  </div>

                  <div id="vendorErrorBox"
                      class="alert alert-danger d-none mb-3">
                  </div>
                  
                  <form id="vendorDataForm"
                      enctype="multipart/form-data">

                    <input type="hidden"
                    name="csrf_token"
                    t-att-value="request.csrf_token()"/>
                  
                    <div class="mb-4">
                      <label class="form-label fw-semibold">Vendor Website / Data URL</label>
                      <input type="url" class="form-control"
                            placeholder="https://vendor-site.com/catalog" name="data_url" />
                    </div>

                     <div class="text-center mb-3 text-muted">— OR —</div>

                
                    <div class="row g-3">

                      <div class="col-md-6">
                        <div class="upload-card">
                          <label class="upload-label">Upload PDF Catalog</label>
                          <input type="file" accept=".pdf" name="pdf_file" class="form-control"/>
                        </div>
                      </div>

                    
                      <div class="col-md-6">
                        <div class="upload-card">
                          <label class="upload-label">Upload Excel / CSV</label>
                          <input type="file" name="excel_file" accept=".xls,.xlsx,.csv" class="form-control"/>
                        </div>
                      </div>

                    
                      <div class="col-md-12 vendor_logo">
                        <div class="upload-card">
                          <label class="upload-label">Vendor Logo (optional)</label>
                          <input type="file" name="logo_file" accept="image/*" class="form-control"/>
                        </div>
                      </div>

                    </div>

                    <div class="mt-4">
                      <label class="form-label fw-semibold">
                        Additional Information (Optional)
                      </label>
                      <textarea name="extra_info" class="form-control" rows="4"
                        placeholder="Provide pricing notes, MOQ, printing methods, special instructions, etc."></textarea>
                    </div>

                    <div class="modal-footer">
                      <button type="submit" class="btn btn-outline-secondary"
                              data-bs-dismiss="modal">Cancel</button>
                      <button class="btn btn-primary px-4">
                        Submit Data
                      </button>
                    </div>

                </form>
                </div>

              </div>
            </div>
          </div>

          <!--vendor products-->
          <div class="modal fade"
            id="vendorProductsModal"
            tabindex="-1">

            <div class="modal-dialog modal-xl modal-dialog-scrollable">

                <div class="modal-content">

                    <!-- HEADER -->

                    <div class="modal-header">

                        <div class="d-flex align-items-center justify-content-between w-100 gap-3 flex-wrap">

                            <h5 class="modal-title mb-0">
                                My Uploaded Products
                            </h5>

                            <div class="vendor-product-search-wrap">

                                <input
                                    type="text"
                                    id="vendorProductSearch"
                                    class="form-control vendor-product-search"
                                    placeholder="Search products..."
                                />

                            </div>

                        </div>

                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                        </button>

                    </div>

                    <!-- BODY -->

                    <div class="modal-body">

                        <div id="vendorProductsGrid"
                            class="row g-3">

                        </div>

                    </div>

                    <!-- FOOTER -->

                    <div class="modal-footer justify-content-between">

                        <button class="btn btn-secondary"
                                id="vendorPrevPage">
                            Previous
                        </button>

                        <span id="vendorPageInfo">
                            Page 1
                        </span>

                        <button class="btn btn-primary"
                                id="vendorNextPage">
                            Next
                        </button>

                    </div>

                </div>

            </div>
        </div>

    <!--vendor product form view-->
      <!-- ===================================================== =======-->
      <!-- PRODUCT DETAILS MODAL -->
      <!-- ===================================================== =======-->

      <div class="modal fade"
          id="vendorProductDetailsModal"
          tabindex="-1">

          <div class="modal-dialog modal-xl modal-dialog-scrollable">

              <div class="modal-content vendor-details-modal">

                  <!-- HEADER -->

                  <div class="modal-header">

                      <h5 class="modal-title">
                          Product Details
                      </h5>

                      <button type="button"
                              class="btn-close"
                              data-bs-dismiss="modal">
                      </button>

                  </div>


                  <!-- BODY -->

                  <div class="modal-body">

                      <!-- WARNING -->

                      <div id="vendorProductWarning"
                          class="vendor-product-warning d-none">
                      </div>


                      <div class="row g-4">

                          <!-- IMAGE PANEL -->

                          <div class="col-lg-4">

                              <div class="vendor-image-panel">

                                  <img id="vendorProductPreview"
                                      class="vendor-product-preview" />

                                  <input type="file"
                                        id="vendorProductImage"
                                        class="form-control mt-3" />

                              </div>

                          </div>


                          <!-- PRODUCT FORM -->

                          <div class="col-lg-8">

                              <form id="vendorProductForm">

                                  <input type="hidden"
                                        id="vendorProductId" />


                                  <div class="row g-3">

                                      <!-- NAME -->

                                      <div class="col-md-6">

                                          <label class="form-label">
                                              Product Name
                                          </label>

                                          <input type="text"
                                                id="vendorProductName"
                                                class="form-control" />

                                      </div>


                                      <!-- CATEGORY -->

                                      <div class="col-md-6">

                                          <label class="form-label">
                                              Category
                                          </label>

                                                <select
                                                id="vendorProductCategory"
                                                class="form-select">

                                                <option value="">
                                                    Select Category
                                                </option>

                                            </select>

                                      </div>


                                      <!-- PRICE -->

                                      <div class="col-md-6">

                                          <label class="form-label">
                                              Price
                                          </label>

                                          <input type="number"
                                                step="0.01"
                                                id="vendorProductPrice"
                                                class="form-control" />

                                      </div>


                                      <!-- STATUS -->

                                      <div class="col-md-6">

                                          <label class="form-label">
                                              Status
                                          </label>

                                          <input type="text"
                                                id="vendorProductStatus"
                                                class="form-control"
                                                readonly="readonly" />

                                      </div>


                                      <!-- DATE CREATED -->

                                      <div class="col-md-6">

                                          <label class="form-label">
                                              Date Created
                                          </label>

                                          <input type="text"
                                                id="vendorProductDate"
                                                class="form-control"
                                                readonly="readonly" />

                                      </div>


                                      <!-- DESCRIPTION -->

                                      <div class="col-12">

                                          <label class="form-label">
                                              Description
                                          </label>

                                          <textarea id="vendorProductDescription"
                                                    rows="5"
                                                    class="form-control">
                                          </textarea>

                                      </div>

                                  </div>

                              </form>

                          </div>

                      </div>

                  </div>


                  <!-- FOOTER -->

                  <div class="modal-footer justify-content-between">

                      <!-- DELETE -->

                      <button class="btn btn-danger"
                              id="deleteVendorProductBtn">

                          Delete Product

                      </button>


                      <!-- SAVE -->

                      <button class="btn btn-dark"
                              id="saveVendorProductBtn">

                          Save Changes

                      </button>

                  </div>

              </div>

          </div>

      </div>
    </xpath>
  </template>
</odoo>