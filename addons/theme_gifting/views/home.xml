<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- =====================================================
       HERO SECTION (Reusable Snippet-Style Section)
       ===================================================== -->
  <template id="gifting_hero" name="Gifting Hero Slider">

    <!-- IMPORTANT: oe_structure makes section editable -->
    <section class="gifting-hero">

  <div id="giftingHeroCarousel" class="carousel slide" data-bs-ride="carousel">

    <div class="carousel-inner">

      <!-- ✅ SLIDE 1 (TEXT + IMAGE) -->
      <div class="carousel-item active">

        <div class="gifting-container">
          <div class="gifting-hero-inner">

            <div class="gifting-hero-text">
              <h1>Branded Solutions That Break Through.</h1>
              <p>
                Elevate your brand with unique experiences that excite and
                foster a deeper connection with your employees and customers.
              </p>
              <a href="#" class="btn btn-success hero-btn hero-btn-explore">Explore</a>
            </div>

            <div class="gifting-hero-image">
               <img src="/theme_gifting/static/src/img/hero-1.png" alt="Hero Image"/>
            </div>

          </div>
        </div>

      </div>

      <!-- ✅ SLIDE 2 (FULL WIDTH BG) -->

      <div class="carousel-item hero-bg-slide hero-bg-one"
    t-attf-style="
        background-image:url('/theme_gifting/static/src/img/banners/hero2-#{(request.env.lang or 'en_US')[:2]}.png');
    ">

        <div class="gifting-container">
          <div class="hero-overlay-text">
            <!-- <h2>Global Gifting Made Easy</h2> -->
          </div>
        </div>

      </div>

      <!-- ✅ SLIDE 3 -->
      <div class="carousel-item hero-bg-slide hero-bg-one"
    t-attf-style="
        background-image:url('/theme_gifting/static/src/img/banners/hero3-#{(request.env.lang or 'en_US')[:2]}.png');
    ">

        <div class="gifting-container">
          <div class="hero-overlay-text">
            <!-- <h2>Effortless Business Solutions</h2> -->
          </div>
        </div>

      </div>

    </div>

    <!-- CONTROLS -->
    <button class="carousel-control-prev" type="button" data-bs-target="#giftingHeroCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#giftingHeroCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon"></span>
    </button>

  </div>

</section>

  </template>


  <!-- =====================================================
       HOMEPAGE EXTENSION (SAFE & EDITABLE)
       ===================================================== -->
  <template id="homepage" inherit_id="website.homepage">

    <!-- DO NOT REPLACE wrap — insert INSIDE -->
    <xpath expr="//div[@id='wrap']" position="inside">

      <!-- Your hero section -->
      <t t-call="theme_gifting.gifting_hero"/>

      <!--⭐ companies logos -->
      <t t-call="theme_gifting.section_company_logos"/>

      <!--⭐ categpry products -->
      <t t-call="theme_gifting.section_main_category"/>
     
      <!--⭐ new_arrivals -->
      <t t-call="theme_gifting.section_new_arrivals"/>

       <!--⭐ section_cta_banner -->
      <t t-call="theme_gifting.section_cta_banner"/>
      
       <!--⭐ promotion -->
      <t t-call="theme_gifting.section_promotions"/>

       <!--⭐ section_cta_banner -->
      <t t-call="theme_gifting.section_cta_banner"/>

      <!-- ⭐ PROMOTIONAL PRODUCTS -->
      <t t-call="theme_gifting.section_promotional_products"/>

       <!--⭐ section_cta_banner -->
      <t t-call="theme_gifting.section_cta_banner"/>

      <!-- popular categories carousel -->
      <t t-call="theme_gifting.section_popular_categories_carousel"/>

       <!--⭐ section_cta_banner -->
      <t t-call="theme_gifting.section_cta_banner"/>

      <!-- ⭐ faq -->
     <t t-call="theme_gifting.section_faq"/>

    <!-- ⭐ newsletter -->
    <t t-call="theme_gifting.section_newsletter"/>

    <!--=================================================
              EMPTY EDITABLE AREA FOR FUTURE SECTIONS
              (Products, promos, etc.)
        ================================================= -->
      <section class="oe_structure"/>

    </xpath>
  </template>
</odoo>
