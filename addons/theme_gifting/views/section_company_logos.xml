<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <template id="section_company_logos" name="Company Logos">

      <section class="company-logos py-5 bg-white">

        <div class="container">

          <div id="logoCarousel"
               class="carousel slide"
               data-bs-ride="carousel"
               data-bs-interval="3500">

            <div class="carousel-inner text-center">

              <!-- Slide 1-->
              <div class="carousel-item active">
                <div class="d-flex justify-content-around align-items-center flex-wrap">

                  <img src="/theme_gifting/static/src/img/coy1.png" class="logo-img"/>
                  <img src="/theme_gifting/static/src/img/coy2.png" class="logo-img"/>
                  <img src="/theme_gifting/static/src/img/coy3.png" class="logo-img"/>
                  <img src="/theme_gifting/static/src/img/coy4.png" class="logo-img"/>
                  <img src="/theme_gifting/static/src/img/coy1.png" class="logo-img"/>
                  <img src="/theme_gifting/static/src/img/coy2.png" class="logo-img"/>

                </div>
              </div>

              <!-- Slide 2 -->
              <div class="carousel-item">
                <div class="d-flex justify-content-around align-items-center flex-wrap">

                  <img src="/theme_gifting/static/src/img/coy1.png" class="logo-img"/>
                  <img src="/theme_gifting/static/src/img/coy2.png" class="logo-img"/>
                  <img src="/theme_gifting/static/src/img/coy3.png" class="logo-img"/>

                </div>
              </div>

            </div>

          </div>

        </div>

      </section>

    </template>

  </data>
</odoo>