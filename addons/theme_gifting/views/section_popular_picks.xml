<section class="container py-5">

  <div class="text-center mb-4">
    <h2 class="fw-bold">Unmissable Deals &amp; Popular Picks</h2>
    <p class="text-muted">
      Save time and money with our best bulk offers
    </p>
  </div>

  <!-- ROW 1: 3 PRODUCTS -->
  <div class="row g-4">

    <t t-foreach="products[:3] or []" t-as="product">

      <div class="col-lg-4 col-md-6 col-6">

        <!-- PASS product INTO CARD -->
        <t t-call="theme_gifting.product_card">
          <t t-set="product" t-value="product"/>
        </t>

      </div>

    </t>

  </div>

  <!-- ROW 2: 4 PRODUCTS -->
  <div class="row g-4 mt-2">

    <t t-foreach="products[3:7] or []" t-as="product">

      <div class="col-lg-3 col-md-6 col-6">

        <t t-call="theme_gifting.product_card">
          <t t-set="product" t-value="product"/>
        </t>

      </div>

    </t>

  </div>

</section>