<odoo>
  <data>

    <template id="section_popular_picks"
              name="Popular Picks">

      <section class="container py-5">

        <div class="text-center mb-4">
          <h2 class="fw-bold">Unmissable Deals &amp; Popular Picks</h2>
          <p class="text-muted">
            Save time and money with our best bulk offers
          </p>
        </div>

        <div class="row g-4">

          <t t-foreach="products or []" t-as="product">

            <div class="col-lg-3 col-md-4 col-6">

              <t t-call="theme_gifting.product_card"/>

            </div>

          </t>

        </div>

      </section>

    </template>

  </data>
</odoo>