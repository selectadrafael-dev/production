<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <template id="section_popular_picks"
              name="Popular Picks Section">

      <!-- ⭐ EXACT CATEGORY RECORD -->
      <t t-set="cat"
         t-value="request.env.ref('theme_gifting.category_popular_picks')"/>

      <!-- ⭐ STRICT PRODUCT QUERY (NO MIXING POSSIBLE) -->
      <t t-set="products"
         t-value="request.env['product.template'].search([
             ('website_published','=',True),
             ('sale_ok','=',True),
             ('public_categ_ids','=',cat.id)
         ], order='id desc', limit=7)"/>

      <section class="container py-5">

        <!-- SECTION HEADER -->
        <div class="text-center mb-4">
          <h2 class="fw-bold">Unmissable Deals &amp; Popular Picks</h2>
          <p class="text-muted">
            Save time and money with our best bulk offers
          </p>
        </div>

        <!-- ===================== -->
        <!-- ROW 1 → FIRST 3 ITEMS -->
        <!-- ===================== -->
        <div class="row g-4">

          <t t-foreach="products[:3]" t-as="product">

            <div class="col-lg-4 col-md-6 col-6">

              <t t-call="theme_gifting.product_card">
                <t t-set="product" t-value="product"/>
              </t>

            </div>

          </t>

        </div>

        <!-- ===================== -->
        <!-- ROW 2 → NEXT 4 ITEMS -->
        <!-- ===================== -->
        <div class="row g-4 mt-2">

          <t t-foreach="products[3:7]" t-as="product">

            <div class="col-lg-3 col-md-6 col-6">

              <t t-call="theme_gifting.product_card">
                <t t-set="product" t-value="product"/>
              </t>

            </div>

          </t>

        </div>

        <!-- EMPTY STATE -->
        <t t-if="not products">
          <div class="text-center text-muted py-5">
            No products found in this category.
          </div>
        </t>

      </section>

    </template>

  </data>
</odoo>