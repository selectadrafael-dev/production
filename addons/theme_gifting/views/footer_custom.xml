<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- Override Website Footer -->
  <template id="footer_custom"
            inherit_id="website.footer"
            name="Selectad Custom Footer">

    <xpath expr="//footer" position="replace">

      <footer class="selectad-footer">

        <!-- ===== TOP FOOTER ===== -->
        <div class="footer-main">

          <div class="container">

            <div class="row">

              <!-- BRAND -->
              <div class="col-lg-4 col-md-12 mb-4">

                <div class="footer-brand">

                  <img src="/theme_gifting/static/src/img/logo-light.svg"
                       alt="Selectad"
                       class="footer-logo"/>

                  <p class="footer-tagline">
                    #1 Reklam Bazarı ↗
                  </p>

                </div>

              </div>

              <!-- CUSTOMER SERVICE -->
              <div class="col-lg-2 col-md-4 col-6">

                <h6>Müştəri xidməti</h6>

                <ul>
                  <li><a href="#">Hesabım</a></li>
                  <li><a href="#">Səbət</a></li>
                  <li><a href="#">Favorilər</a></li>
                </ul>

              </div>

              <!-- INFORMATION -->
              <div class="col-lg-2 col-md-4 col-6">

                <h6>Məlumat</h6>

                <ul>
                  <li><a href="#">Məxfilik Siyasəti</a></li>
                  <li><a href="#">İstifadə Şərtləri</a></li>
                  <li><a href="#">Tez-tez verilən suallar</a></li>
                </ul>

              </div>

              <!-- CONTACT -->
              <div class="col-lg-4 col-md-4 col-12">

                <h6>Əlaqə</h6>

                <p class="footer-contact">
                  Mayakovski 19, Baku,<br/>
                  Azərbaycan, AZ1054
                </p>

                <p>
                  <a href="mailto:ask@selectad.com">
                    ask@selectad.com
                  </a>
                </p>

                <!-- SOCIAL -->
                <div class="footer-social">

                  <a href="#"><i class="fa fa-whatsapp"></i></a>
                  <a href="#"><i class="fa fa-facebook"></i></a>
                  <a href="#"><i class="fa fa-instagram"></i></a>
                  <a href="#"><i class="fa fa-linkedin"></i></a>

                </div>

              </div>

            </div>

          </div>

        </div>

        <!-- ===== BOTTOM BAR ===== -->
        <div class="footer-bottom">

          <div class="container d-flex flex-wrap align-items-center justify-content-between">

            <div class="footer-left">
              Şərtlər və qaydalar<br/>
              © Selectad 2024. All right reserved
            </div>

            <div class="footer-right d-flex align-items-center gap-3">

              <!-- Language -->
              <div class="footer-lang">
                AZ 🇦🇿
              </div>

              <!-- Payment icons -->
              <div class="footer-payments">
                <img src="/theme_gifting/static/src/img/visa.svg" alt="Visa"/>
                <img src="/theme_gifting/static/src/img/mastercard.svg" alt="Mastercard"/>
              </div>

            </div>

          </div>

        </div>

      </footer>

    </xpath>

  </template>

</odoo>