<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <template id="footer_custom"
            inherit_id="website.layout"
            name="Selectad Custom Footer">

    <!-- Replace default footer -->
    <xpath expr="//footer" position="replace">

      <footer class="selectad-footer">

        <!-- ======= TOP ======= -->
        <div class="footer-main">

          <div class="container">
            <div class="row">

              <!-- BRAND -->
              <div class="col-lg-3 col-md-12 mb-4">

                <img src="/theme_gifting/static/src/img/logo.png"
                     class="footer-logo"/>

                <p class="footer-tagline">
                  Advertising Market ↗
                </p>

              </div>

              <!-- CUSTOMER SERVICE -->
              <div class="col-lg-2 col-md-3 col-6">

                <h6>Customer Service</h6>

                <ul>
                  <li><a href="#">
                  My Account
                  </a></li>
                  <li><a href="#">
                    Cart
                  </a></li>
                  <li><a href="#">
                   Favorites
                  </a></li>
                </ul>

              </div>

              <!-- INFORMATION -->
              <div class="col-lg-2 col-md-3 col-6">

                <h6>
               Information
                </h6>

                <ul>
                  <li><a href="#">
                 Privacy Policy
                  </a></li>
                  <li><a href="#">
                 Terms of Use
                  </a></li>
                  <li>
                  <a href="#">
                 Frequently Asked Questions
                  </a>
                  </li>
                </ul>

              </div>
             
              <!-- INFORMATION -->
              <div class="col-lg-2 col-md-3 col-6">

                <h6>More Info</h6>

                <ul>
                  <li><a href="#">Shop (Categories)</a></li>
                  <li><a href="#">Customer Service</a></li>
                  <li><a href="#">Our Company</a></li>
                  <li><a href="#">Contact</a></li>
                  <li><a href="/web/login">Be a Vendor</a></li>
                </ul>

              </div>

              <!-- CONTACT -->
              <div class="col-lg-3 col-md-3 col-12">

                <h6>
               Contact
                </h6>

                <p class="footer-contact">
                  Mayakovski 19, Baku,<br/>
                  Azərbaycan, AZ1054



                </p>

                <p>
                  <a href="mailto:ask@selectad.com">
                    ask@selectad.com
                  </a>
                </p>

                <!-- SOCIAL -->
                <div class="footer-social">
                  <a href="#"><i class="fa fa-whatsapp"></i></a>
                  <a href="#"><i class="fa fa-facebook"></i></a>
                  <a href="#"><i class="fa fa-instagram"></i></a>
                  <a href="#"><i class="fa fa-linkedin"></i></a>
                </div>

              </div>

            </div>
          </div>

        </div>

        <!-- ===== BOTTOM BAR ===== -->
        <div class="footer-bottom">

          <div class="container d-flex flex-wrap align-items-center justify-content-between">

            <div class="footer-left">
              © Selectad 2026. All right reserved
            </div>

            <div class="footer-right d-flex align-items-center gap-3">

              <div class="footer-lang">
                AZ 🇦🇿
              </div>

              <div class="footer-payments">
                <img src="/theme_gifting/static/src/img/visa_icon.png"/>
                <img src="/theme_gifting/static/src/img/master_card_icon.png"/>
              </div>

            </div>

          </div>

        </div>

      </footer>

    </xpath>

  </template>

</odoo>