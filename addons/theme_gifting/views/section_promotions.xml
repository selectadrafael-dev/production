<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <template id="section_promotions"
              name="Promotions Section">

      <!-- Fetch LAST 6 products from Promotions category -->
      <t t-set="products"
         t-value="request.env['gifting.product.helper']
                  .get_latest_products(
                  'theme_gifting.category_promotions', 6)"/>

      <section class="promo-section py-5">

        <div class="container">

          <!-- HEADER -->
          <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
              <span class="promo-badge">Bu ay</span>
              <h2 class="promo-title">Promotions</h2>
            </div>

            <a href="/shop"
               class="promo-more">See more</a>

          </div>

          <!-- HORIZONTAL SCROLL AREA -->
          <div class="promo-scroll">

            <div class="promo-track">

              <t t-foreach="products or []" t-as="product">

                <t t-call="theme_gifting.product_card_promo"/>

              </t>

            </div>

          </div>

        </div>

      </section>

    </template>

  </data>
</odoo>