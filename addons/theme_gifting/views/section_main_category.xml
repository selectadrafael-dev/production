<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <template id="section_main_category"
              name="Main Category Grid">

      <!-- Fetch 8 products from PUBLIC category -->
      <t t-set="products"
         t-value="request.env['gifting.product.helper']
                  .get_latest_products(
                  'theme_gifting.category_main_category', 8)"/>

      <section class="main-category-section py-5">

        <div class="container">

          <!-- Title -->
          <h3 class="fw-bold mb-4">
            Kateqoriyalar
          </h3>

          <!-- Grid -->
          <div class="row g-4">

            <t t-if="products">

              <t t-foreach="products" t-as="product">

                <div class="col-lg-3 col-md-4 col-6">

                  <a t-att-href="'/shop/product/%s' % product.id"
                     class="text-decoration-none">

                    <div class="category-card">

                      <div class="category-img">
                        <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"/>
                      </div>

                      <div class="category-name d-flex justify-content-beween">
                        <div class="category-name-main">
                             <t t-esc="product.name"/>
                        </div>
                        
                        <div class="hidden-price">
                             $ <t t-esc="product.list_price"/>
                        </div>
                      </div>
                    </div>

                  </a>

                </div>

              </t>

            </t>

            <t t-if="not products">
              <div class="col-12 text-center text-muted">
                No products found in this category.
              </div>
            </t>

          </div>

          <!-- Bottom link -->
          <div class="text-center mt-4">
            <a href="/shop"
               class="more-link">
               Daha çox
            </a>
          </div>

        </div>

      </section>

    </template>

  </data>
</odoo>