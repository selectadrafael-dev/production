<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="gifting_navbar"
            inherit_id="website.navbar"
            name="Gifting Custom Navbar">

    <xpath expr="//nav" position="replace">

      <nav class="gifting-navbar">

        <div class="gifting-container gifting-nav-container">

          <!-- ===== TOP ROW ===== -->
          <div class="gifting-nav-top">

            <!-- LOGO -->
            <a href="/" class="gifting-logo">
              <img src="/theme_gifting/static/src/img/logo.png" alt="Logo"/>
            </a>

            <!-- SEARCH -->
            <div class="gifting-search">
              <form action="/shop" method="get" class="o_wsale_products_search_form">
                <input type="text" name="search" placeholder="Search gifts..." class="form-control"/>
                <button type="submit">🔍</button>
              </form>
            </div>

            <!-- ICONS + LANGUAGE -->
            <div class="gifting-icons-wrapper">

              <div class="js_language_selector">
                <t t-call="website.language_selector"/>
              </div>

              <div class="gifting-icons">
                   <div class="gifting-contact">
                      <div class="contact-dropdown">

                        <!-- Trigger -->
                        <span class="contact-trigger">
                          <i class="fa fa-headphones"></i>
                           <span class="contact-text">Help &amp; Contact</span>
                          <i class="fa fa-chevron-down"></i>
                        </span>

                        <!-- Dropdown -->
                        <div class="contact-menu">

                          <a href="/contactus" class="contact-item">
                            Contact
                          </a>

                          <a href="#" class="contact-item">
                            <i class="fa fa-comments"></i>
                            Chat with us
                          </a>

                          <div class="contact-item contact-phone">
                            <i class="fa fa-phone"></i>
                            <div>
                              <strong>0116 366 0052</strong>
                              <small>Mon - Friday 9:00 - 17:30</small>
                            </div>
                          </div>

                        </div>

                      </div>
                   </div>

                <!-- <t t-if="not request.env.user._is_public()"> -->
                <t t-if="request.session.uid and request.env.user.has_group('base.group_portal')">
                  <a href="/shop/wishlist" class="icon">❤️</a>
                </t>

                <a href="#" class="icon cart-icon js-open-quote">
                  🛒 <span class="cart-count">0</span>
                </a>

                <div class="gifting-account">
                  <t t-if="request.session.uid">
                    <div class="account-dropdown">
                      <span class="icon">👤 ▾</span>

                      <div class="dropdown-menu custom-acount-user-menu">

                        <a href="/my">My Account</a>
                        <a href="/my/orders">Orders</a>

                        <t t-set="user" t-value="request.env.user"/>

                        <t t-if="not user._is_public() and 
                                (user.has_group('base.group_system') or user.partner_id.is_vendor_user)">
                          <button type="button"
                                  class="vendor-data-link"
                                  data-bs-toggle="modal"
                                  data-bs-target="#vendorDataModal">
                            Vendor Data
                          </button>
                        </t>

                        <a href="/web/session/logout">Logout</a>

                      </div>
                    </div>
                  </t>

                  <t t-else="">
                    <a href="/web/login" class="login-btn">Login</a>
                  </t>
                </div>

              </div>

            </div>

          </div> <!-- ✅ CLOSED gifting-nav-top -->


          <!-- ===== SECOND ROW ===== -->
          <div class="gifting-nav-bottom">
           <div>
                <div class="gifting-categories">

                  <button class="cat-btn mobile-cat-toggle" data-cat-toggle="1">
                    ☰ All Products
                  </button>
                
                </div>

                <div class="gifting-links">
                  <t t-set="arriv"
                      t-value="request.env.ref(
                          'theme_gifting.category_new_arrivals'
                      )"/>

                    <a t-att-href="'/shop/category/%s' % slug(arriv)">
                      New Arrivals
                    </a>

                    <t t-set="promot"
                      t-value="request.env.ref(
                          'theme_gifting.category_promotions'
                      )"/>

                    <a t-att-href="'/shop/category/%s' % slug(promot)">
                      Promotions
                    </a>

                    <t t-set="bseller"
                      t-value="request.env.ref(
                          'theme_gifting.category_seller'
                      )"/>

                    <a t-att-href="'/shop/category/%s' % slug(bseller)">
                      Best Sellers
                    </a>

                    <t t-set="specoffers"
                      t-value="request.env.ref(
                          'theme_gifting.category_specffers'
                      )"/>

                    <a t-att-href="'/shop/category/%s' % slug(specoffers)">
                      Special Offers
                    </a>

                    <t t-set="frendly"
                      t-value="request.env.ref(
                          'theme_gifting.eco_friendly'
                      )"/>

                    <a t-att-href="'/shop/category/%s' % slug(frendly)">
                      Eco friendly
                    </a>
                </div>
            </div>

            <div class="me-2">
              Vat Switch
            </div>

          </div>
        </div>

        <div class="mobile-overlay"></div>
      </nav>

      <!---==========mega menu================-->
        <div class="cat-mega-global" data-cat-menu="1">

                <t t-set="categories"
                   t-value="request.env['product.public.category'].sudo().search([('parent_id','=',False)])"/>

                <div class="mega-wrapper">

                  <!-- LEFT -->
                  <div class="mega-left">
                    <t t-foreach="categories" t-as="cat" t-key="cat.id">
                      <div class="mega-left-item" t-att-data-cat-id="cat.id">
                        <span t-esc="cat.name"/>
                        <span class="arrow">›</span>
                      </div>
                    </t>
                  </div>

                  <!-- RIGHT -->
                  <div class="mega-right">
                    <t t-foreach="categories" t-as="cat" t-key="cat.id">
                      <div class="mega-panel" t-att-data-panel-id="cat.id">
                        <div class="mega-panel-grid">

                          <t t-if="cat.child_id">

                              <t t-foreach="cat.child_id" t-as="sub">

                                <!-- SUBCATEGORY TITLE -->
                                <div class="mega-subcategory">

                                  <div class="mega-sub-title">
                                    <t t-esc="sub.name"/>
                                  </div>

                                  <!-- SUB-SUB -->
                                  <div class="mega-sub-list">

                                    <t t-if="sub.child_id">
                                      <t t-foreach="sub.child_id" t-as="child">

                                        <a t-att-href="'/shop/category/%s' % child.id"
                                          class="mega-sub">
                                          <t t-esc="child.name"/>
                                        </a>

                                      </t>
                                    </t>

                                  </div>

                                </div>

                              </t>

                            </t>

                        </div>
                      </div>
                    </t>
                  </div>

                </div> <!-- ✅ CLOSED mega-wrapper -->
              </div>

               <!--mobile category logic-->
                  <div class="mobile-cat-drawer">
                   <!-- 🔥close btn -->
                    <div class="mobile-drawer-top">
                      <button class="drawer-close" type="button">×</button>
                    </div>

                    <!-- LEVEL 1 -->
                    <div class="mobile-panel active" data-level="1">

                      <t t-foreach="categories" t-as="cat">
                        <div class="mobile-item"
                            t-att-data-target="'cat-' + str(cat.id)">
                          <span t-esc="cat.name"/>
                          <span class="arrow">›</span>
                        </div>
                      </t>

                    </div>

                    <!-- LEVEL 2 -->
                    <t t-foreach="categories" t-as="cat">
                      <div class="mobile-panel"
                          t-att-data-panel="'cat-' + str(cat.id)">

                        <div class="mobile-header">
                          <span class="mobile-back">← Back</span>
                          <span class="mobile-title" t-esc="cat.name"/>
                        </div>

                        <t t-foreach="cat.child_id" t-as="sub">
                          <div class="mobile-item"
                              t-att-data-target="'sub-' + str(sub.id)">
                            <span t-esc="sub.name"/>
                            <span class="arrow">›</span>
                          </div>
                        </t>

                      </div>
                    </t>

                    <!-- LEVEL 3 -->
                    <t t-foreach="categories" t-as="cat">
                      <t t-foreach="cat.child_id" t-as="sub">

                        <div class="mobile-panel"
                            t-att-data-panel="'sub-' + str(sub.id)">

                          <div class="mobile-header">
                            <span class="mobile-back">← Back</span>
                            <span class="mobile-title" t-esc="sub.name"/>
                          </div>

                          <t t-foreach="sub.child_id" t-as="child">
                            <a t-att-href="'/shop/category/%s' % child.id"
                              class="mobile-link">
                              <t t-esc="child.name"/>
                            </a>
                          </t>

                        </div>

                      </t>
                    </t>

                  </div>
              <!--mobile category logic-->

    </xpath>

  </template>

</odoo>