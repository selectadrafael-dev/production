<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="gifting_navbar"
            inherit_id="website.navbar"
            name="Gifting Custom Navbar">

    <xpath expr="//nav" position="replace">

      <nav class="gifting-navbar">

        <!--div class="gifting-nav-container"-->
        <div class="gifting-container gifting-nav-container">

          <!-- ===== TOP ROW ===== -->
          <div class="gifting-nav-top">

            <!-- LOGO -->
            <a href="/" class="gifting-logo">
              <img src="/theme_gifting/static/src/img/logo.png"
                   alt="Logo"/>
            </a>

            <button class="mobile-toggle" aria-label="Menu">
              ☰
            </button>
            

            <!-- CENTER SEARCH (REAL ODOO SEARCH) -->
            <div class="gifting-search">
                <form action="/shop"
                      method="get"
                      class="o_wsale_products_search_form">

                  <input type="text"
                        name="search"
                        placeholder="Search gifts..."
                        class="form-control"/>

                  <button type="submit">🔍</button>

                </form>
              </div>

              <!-- ACTION ICONS -->
              <div class="gifting-icons">
                 
                <t t-call="website.language_selector"/>

                <!-- Wishlist -->
              <t t-if="not request.env.user._is_public()">
                  <a href="/shop/wishlist" class="icon">❤️</a>
              </t>

                <!-- Cart -->
                <a href="#" class="icon cart-icon js-open-quote">
                  🛒 <span class="cart-count">0</span>
                </a>


                <!-- Account -->
                <div class="gifting-account">
                  <!-- Logged IN -->
                  <t t-if="request.session.uid">

                    <div class="account-dropdown">

                      <span class="icon">👤 ▾</span>

                      <div class="dropdown-menu custom-acount-user-menu">

                        <a href="/my"  t-translation="on">
                        
                         My Account
                        </a>
                        <a href="/my/orders"  t-translation="on">
                           Orders
                        </a>
              
                            <t t-set="user" t-value="request.env.user"/>

                            <t t-if="not user._is_public() and 
                                    (user.has_group('base.group_system') or user.partner_id.is_vendor_user)">

                                <button type="button" 
                                        class="vendor-data-link"
                                        data-bs-toggle="modal"
                                        data-bs-target="#vendorDataModal">
                                    Vendor Data
                                </button>

                            </t>

                            <!-- <t t-esc="request.env.user.partner_id.is_vendor_user"/> -->

                        <a href="/web/session/logout"  t-translation="on">
                         Logout
                        </a>
                      </div>
                    </div>
                  </t>

                  <!-- NOT logged in -->
                  <t t-else="">

                    <a href="/web/login" class="login-btn"  t-translation="on">
                       Login
                    </a>

                  </t>
                </div>
                
              </div>
          </div>

          <!-- ===== SECOND ROW ===== -->
          <div class="gifting-nav-bottom">
              <button class="mobile-close" aria-label="Close Menu">✕</button>

            <div class="gifting-categories" t-translation="on">

              <button class="cat-btn mobile-cat-toggle">
                ☰ All Products
              </button>

              <div class="cat-mega" data-cat-menu="1" hidden="hidden">

                <t t-set="categories"
                  t-value="request.env['product.public.category'].sudo().search([('parent_id','=',False)])"/>

                <div class="mega-wrapper">

                  <!-- LEFT SIDEBAR -->
                  <div class="mega-left">

                    <t t-foreach="categories" t-as="cat" t-key="cat.id">

                      <div class="mega-left-item"
                          t-att-data-cat-id="cat.id">

                        <span t-esc="cat.name"/>
                        <span class="arrow">›</span>

                      </div>

                    </t>

                  </div>

                  <!-- RIGHT PANEL -->
                  <div class="mega-right">

                    <t t-foreach="categories" t-as="cat" t-key="cat.id">

                      <div class="mega-panel"
                          t-att-data-panel-id="cat.id"
                          style="display:none;">

                        <div class="mega-panel-grid">

                          <t t-if="cat.child_id">
                            <t t-foreach="cat.child_id" t-as="sub">

                              <a t-att-href="'/shop/category/%s' % sub.id"
                                class="mega-sub">
                                <t t-esc="sub.name"/>
                              </a>

                            </t>
                          </t>

                        </div>

                      </div>

                    </t>

                  </div>

                </div>

              </div>

            </div>

              
            <div class="gifting-links" t-translation="on">
              <a href="#"  t-translation="on">
                New Arrivals
              </a>
              <a href="#"  t-translation="on">
                  Promotions
              </a>
              <a href="#"  t-translation="on">
                Best Sellers
              </a>
              <a href="#"  t-translation="on">
                Special Offers
              </a>
              <a href="#"  t-translation="on">
                 Eco friendly
              </a>
            </div>

          </div>

        </div>

      </nav>

    </xpath>

  </template>

</odoo>
