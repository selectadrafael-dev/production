<odoo>
  <template id="product_card">

    <div class="product-card shadow-sm">

      <a t-att-href="'/shop/product/%s' % product.id">

        <div class="product-image">
          <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"
               alt="product"/>
        </div>

        <div class="product-info p-3">

          <h6 class="fw-bold" t-esc="product.name"/>

          <div class="price">
            <span class="from">from</span>
            <span class="amount">
              <t t-esc="product.list_price"/>
            </span>
            <span class="vat">excl. VAT</span>
          </div>

        </div>
      </a>

    </div>

  </template>
</odoo>