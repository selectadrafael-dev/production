<odoo>

  <template id="product_card">

    <a t-att-href="'/shop/product/%s' % product.id"
       class="product-card-wrapper text-decoration-none">

      <!-- CARD WITH IMAGE ONLY -->
      <div class="product-card shadow-sm">

        <div class="product-img">
          <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"/>
        </div>

      </div>

      <!-- NAME + PRICE BELOW CARD -->
      <div class="product-meta">

        <span class="product-name"
              t-esc="product.name"/>

        <span class="product-price">
          $ <t t-esc="product.list_price"/>
        </span>

      </div>

    </a>

  </template>

</odoo>