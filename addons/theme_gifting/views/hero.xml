<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- =====================================================
       HERO SECTION (Reusable Snippet-Style Section)
       ===================================================== -->
  <template id="gifting_hero" name="Gifting Hero Slider">

    <!-- IMPORTANT: oe_structure makes section editable -->
    <section class="gifting-hero carousel slide oe_structure gifting-home"
             data-bs-ride="carousel"
             data-snippet="gifting_hero">

             <!--div class="carousel-inner"-->
              <div class="carousel-inner">
                   <!-- SLIDE 1 — Your Figma Design -->
                    <div class="carousel-item active gifting-container carousel-item-active">

                        <div class="container hero-content">

                          <div class="gifting-hero-inner">

                            <!-- LEFT: TEXT -->
                            <div class="gifting-hero-text"
                                t-translation="on"
                                t-options='{"no_edit": true}'>

                              <h1>Branded Solutions That Break Through.</h1>

                              <p>
                                Elevate your brand with unique experiences that excite
                                and foster a deeper connection with your employees
                                and customers.
                              </p>

                              <a href="/shop" class="btn btn-primary hero-btn">
                                Explore
                              </a>

                            </div>

                          </div>

                          <!-- RIGHT: IMAGE -->
                          <div class="gifting-hero-image">
                            <img src="/theme_gifting/static/src/img/hero-1.png"
                                alt="Hero"/>
                          </div>

                        </div>
                      </div>
                   
                   <!-- SLIDE 2 — Your Figma Design -->
                  <div class="carousel-item carousel-item-wrapper">
                    <div class="carousel-item-support">
                     <img src="/theme_gifting/static/src/img/banners/banner_1a.png"
                                alt="Hero"/>
                    </div>
                  </div>
                  
                  <!-- SLIDE 3 — Your Figma Design -->
                  <div class="carousel-item carousel-item-wrapper">
                    <div class="carousel-item-support">
                      <img src="/theme_gifting/static/src/img/banners/banner_2a.png"
                                alt="Hero"/>
                    </div>
                  </div>

              </div>
             <!--div class="carousel-inner"-->

     

    </section>

  </template>


  <!-- =====================================================
       HOMEPAGE EXTENSION (SAFE & EDITABLE)
       ===================================================== -->
  <template id="homepage" inherit_id="website.homepage">

    <!-- DO NOT REPLACE wrap — insert INSIDE -->
    <xpath expr="//div[@id='wrap']" position="inside">

      <!-- Your hero section -->
      <t t-call="theme_gifting.gifting_hero"/>

      <!--⭐ companies logos -->
      <t t-call="theme_gifting.section_company_logos"/>

      <!--⭐ categpry products -->
      <t t-call="theme_gifting.section_main_category"/>
     
      <!--⭐ section_cta_banner -->
      <!--t t-call="theme_gifting.section_cta_banner"/-->
      
      <!--⭐ new_arrivals -->
      <t t-call="theme_gifting.section_new_arrivals"/>

       <!--⭐ section_cta_banner -->
      <t t-call="theme_gifting.section_cta_banner"/>
      
       <!--⭐ promotion -->
      <t t-call="theme_gifting.section_promotions"/>

       <!--⭐ section_cta_banner -->
      <t t-call="theme_gifting.section_cta_banner"/>

      <!-- ⭐ PROMOTIONAL PRODUCTS -->
      <t t-call="theme_gifting.section_promotional_products"/>

       <!--⭐ section_cta_banner -->
      <t t-call="theme_gifting.section_cta_banner"/>

      <!-- ⭐ faq -->
     <t t-call="theme_gifting.section_faq"/>

    <!-- ⭐ newsletter -->
    <t t-call="theme_gifting.section_newsletter"/>

    <!--vendor data modalbox-->
   
    <t t-name="vendor_data.modal">
          <div class="modal fade" id="vendorDataModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
              <div class="modal-content vendor-modal">

                <div class="modal-header">
                  <h5 class="modal-title">Upload Vendor Product Data</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                  <!-- ERROR BOX -->
                  <div id="vendorErrorBox" class="alert alert-danger d-none"></div>
                  
                  <form id="vendorDataForm"
                  action="/vendor-data/submit"
                  method="post"
                  enctype="multipart/form-data">

                    <input type="hidden"
                    name="csrf_token"
                    t-att-value="request.csrf_token()"/>
                  
                    <div class="mb-4">
                      <label class="form-label fw-semibold">Vendor Website / Data URL</label>
                      <input type="url" class="form-control"
                            placeholder="https://vendor-site.com/catalog" name="data_url" />
                    </div>

                     <div class="text-center mb-3 text-muted">— OR —</div>

                
                    <div class="row g-3">

                      <div class="col-md-6">
                        <div class="upload-card">
                          <label class="upload-label">Upload PDF Catalog</label>
                          <input type="file" accept=".pdf" name="pdf_file" class="form-control"/>
                        </div>
                      </div>

                    
                      <div class="col-md-6">
                        <div class="upload-card">
                          <label class="upload-label">Upload Excel / CSV</label>
                          <input type="file" name="excel_file" accept=".xls,.xlsx,.csv" class="form-control"/>
                        </div>
                      </div>

                    
                      <div class="col-md-12">
                        <div class="upload-card">
                          <label class="upload-label">Vendor Logo (optional)</label>
                          <input type="file" name="logo_file" accept="image/*" class="form-control"/>
                        </div>
                      </div>

                    </div>

                    <div class="mt-4">
                      <label class="form-label fw-semibold">
                        Additional Information (Optional)
                      </label>
                      <textarea name="extra_info" class="form-control" rows="4"
                        placeholder="Provide pricing notes, MOQ, printing methods, special instructions, etc."></textarea>
                    </div>

                    <div class="modal-footer">
                      <button type="submit" class="btn btn-outline-secondary"
                              data-bs-dismiss="modal">Cancel</button>
                      <button class="btn btn-primary px-4">
                        Submit Data
                      </button>
                    </div>

                </form>
                </div>

                <!--div class="modal-footer">
                  <button class="btn btn-outline-secondary"
                          data-bs-dismiss="modal">Cancel</button>
                  <button class="btn btn-primary px-4">
                    Submit Data
                  </button>
                </div-->

              </div>
            </div>
          </div>
    </t>
    <!--=================================================
              EMPTY EDITABLE AREA FOR FUTURE SECTIONS
              (Products, promos, etc.)
        ================================================= -->
      <section class="oe_structure"/>

    </xpath>
  </template>
</odoo>
