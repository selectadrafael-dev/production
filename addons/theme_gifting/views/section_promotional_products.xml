<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <template id="section_promotional_products"
              name="Promotional Products Section">

      <section class="promo-categories py-5 bg-white">

        <div class="container">

          <div class="text-center mb-5">
            <h2 class="fw-bold">Promotional Products</h2>
            <p class="text-muted">
              Promotional products for your company
            </p>
          </div>

          <!-- Fetch specific promotional categories -->
          <t t-set="cats"
                t-value="request.env['product.public.category'].search([
                    ('name', 'in', [
                        'Fresh and Finds',
                        'Tested and Loved',
                        'Big Savings',
                        'Record Time'
                    ])
                ])"/>

          <div class="row g-4">

            <t t-foreach="cats" t-as="cat">

              <div class="col-lg-3 col-md-6 col-6">

                <a t-att-href="'/shop/category/%s' % cat.id"
                   class="promo-category-card text-decoration-none">

                  <!-- BIG IMAGE CARD -->
                  <div class="promo-image-card shadow-sm">

                    <img t-att-src="'/web/image/product.public.category/%s/image_512' % cat.id"
                         alt="category"/>

                  </div>

                  <!-- CATEGORY NAME ONLY -->
                  <div class="promo-name text-center mt-2">
                    <span t-esc="cat.name"/>
                  </div>

                </a>

              </div>

            </t>

          </div>

        </div>

      </section>

    </template>

  </data>
</odoo>