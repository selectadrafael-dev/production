<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <template id="section_newsletter"
              name="Newsletter Subscribe Section">

      <section class="newsletter-section py-5">

        <div class="container">

          <div class="newsletter-box mx-auto text-center">

            <!-- Title -->
            <h2 class="fw-bold mb-2">
              Yenilikləri izlə
            </h2>

            <!-- Subtitle -->
            <p class="text-muted mb-4">
              Xəbərlərə yazılaraq əlavə endirimlərdən yararlanın.
            </p>

            <!-- Form -->
            <form class="newsletter-form">

              <div class="input-group mb-3">

                <input type="email"
                       class="form-control newsletter-input"
                       placeholder="E-poçt adresini daxil edin"
                       required="required"/>

              </div>

              <button type="submit"
                      class="btn newsletter-btn w-100">

                İzləməyə başla

              </button>

            </form>

          </div>

        </div>

      </section>

    </template>

  </data>
</odoo>