<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <template id="section_popular_categories"
              name="Most Popular Categories Section">

      <!-- Get category -->
      <t t-set="cat"
         t-value="request.env.ref('theme_gifting.category_most_popular')"/>

      <!-- Fetch products -->
      <t t-set="products"
         t-value="request.env['gifting.product.helper']
                  .get_latest_products(
                  'theme_gifting.category_most_popular', 4)"/>

      <section class="most-popular-products bg-light py-5">

        <div class="container">

          <!-- Section Title -->
          <div class="text-center mb-5">
            <h2 class="fw-bold" t-esc="cat.name"/>
            <p class="text-muted">
              Discover our best-selling products
            </p>
          </div>

          <!-- PRODUCTS GRID -->
          <div class="row g-4">

            <t t-if="products">

              <t t-foreach="products" t-as="product">

                <div class="col-lg-3 col-md-6 col-6">

                  <!-- ⭐ USE GLOBAL CARD COMPONENT -->
                  <t t-call="theme_gifting.product_card"/>

                </div>

              </t>

            </t>

            <!-- Empty fallback -->
            <t t-if="not products">
              <div class="col-12 text-center text-muted">
                No products found in this category.
              </div>
            </t>

          </div>

        </div>

      </section>

    </template>

  </data>
</odoo>