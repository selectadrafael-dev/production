<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <template id="section_popular_categories"
              name="Most Popular Categories Section">

      <!-- Get category record -->
      <t t-set="cat"
         t-value="request.env.ref('theme_gifting.category_most_popular')"/>

      <!-- SAFE PRODUCT QUERY -->
      <t t-set="products"
         t-value="request.env['product.template'].search([
             ('website_published','=',True),
             ('sale_ok','=',True),
             ('public_categ_ids','in',[cat.id])
         ], order='id desc', limit=4)"/>

      <section class="most-popular-products bg-light py-5">

        <div class="container">

          <!-- SECTION TITLE -->
          <div class="text-center mb-5">
            <h2 class="fw-bold" t-esc="cat.name"/>
            <p class="text-muted">
              Discover our best-selling products
            </p>
          </div>

          <!-- PRODUCTS GRID -->
          <div class="row g-4">

            <!-- PRODUCT LOOP -->
            <t t-foreach="products" t-as="product">

              <div class="col-lg-3 col-md-6 col-6">

                <!-- USE GLOBAL CARD -->
                <t t-call="theme_gifting.product_card">
                  <t t-set="product" t-value="product"/>
                </t>

              </div>

            </t>

            <!-- EMPTY STATE -->
            <t t-if="not products">
              <div class="col-12 text-center text-muted">
                No products found in this category.
              </div>
            </t>

          </div>

        </div>

      </section>

    </template>

  </data>
</odoo>